---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products.js';

// Tema "kopi Gayo" — tiga kopi dari dataran tinggi yang sama, Gayo Aceh.
// Yang dijual di halaman ini cuma satu keputusan: mau pahit, asam, atau yang unik.
// Halaman tujuan iklan "Video Gayo Web", biar yang diklik dan yang dibuka sama.
// mp = harga referensi marketplace buat anchor 250gr; null kalau angkanya belum ada.
const picks = [
  { slug:"robusta-gayo",      label:"BUAT YANG SUKA PAHIT", tone:"pahit", mp:94000,
    blurb:"Pahit sedang dan sama sekali nggak asem, tapi kafeinnya tetap tinggi. Enak diminum harian tanpa gula." },
  { slug:"arabika-aceh-gayo", label:"BUAT YANG SUKA ASAM",  tone:"asam",  mp:135000,
    blurb:"Asamnya bright dengan karakter fruity, bersih dan gampang disuka. Paling pas diseduh V60 atau manual brew." },
  { slug:"arabika-gayo-wine", label:"BUAT YANG MAU BEDA",   tone:"wine",  mp:158000,
    blurb:"Asamnya tinggi dengan rasa fermentasi yang khas. Namanya wine dari cara prosesnya, bukan karena ada alkoholnya. Aman diminum, halal." },
].map(x => ({ ...x, p: products.find(pr => pr.slug === x.slug) }));

const fmt = (n)=> "Rp " + n.toLocaleString('id-ID');
// intensity di products.js skalanya 0-100; di sini dipetakan jadi 5 titik.
const dots = (v)=> Math.max(0, Math.min(5, Math.round(v/20)));
const testis = Array.from({length:15}, (_,i)=> '/img/testi/'+(i+1)+'.webp');
---
<Base title="3 Kopi Gayo Paling Laris — Kopi Bing" description="Robusta Gayo, Arabika Aceh Gayo, dan Arabika Gayo Wine dari dataran tinggi Gayo, Aceh." noindex={true} naked={true}>
  <div class="wrap lp" id="top">

    <!-- Sama seperti /pahit: tanpa header supaya tidak ada pintu keluar ke beranda.
         Tombol keranjang baru muncul kalau keranjangnya memang sudah ada isinya. -->
    <a class="cartfab" id="cartFab" href="/keranjang?lp=gayo" style="display:none" aria-label="Keranjang">
      <Icon name="cart" /><span class="fabn" id="cartFabN">0</span>
    </a>

    <div class="logo-top"><img src="/img/logo.png" alt="Kopi Bing" /></div>

    <div class="heroilu" data-muncul><img src="/img/ds2/ilustrasi-gayo.svg" alt="" /></div>

    <section class="hero">
      <h1>3 Kopi Gayo Paling Laris di Kopi Bing</h1>
      <p class="sub">Ketiganya dari dataran tinggi yang sama, Gayo Aceh. Tinggal pilih mau yang <b>pahit</b>, yang <b>asam</b>, atau yang <b>rasanya unik</b>. Bisa request gilingan 👇</p>
    </section>

    <section class="cards" data-muncul>
      {picks.map(({p, label, tone, mp, blurb}, idx)=>(
        <a class={"card" + (idx===0 ? " utama" : "")} href={`/produk/${p.slug}?lp=gayo`} data-slug={p.slug} data-pos={idx+1}>
          {/* Foto kemasan, bukan foto biji. Kotaknya 1:1 mengikuti sumbernya (800x800)
              dan pakai object-fit:contain supaya tulisan di kemasan tidak pernah terpotong. */}
          <div class="imgs">
            <img src={`/img/${p.slug}.webp`} alt={p.name} loading={idx===0?"eager":"lazy"} fetchpriority={idx===0?"high":undefined} />
          </div>
          <div class="body">
            <span class={"lvl l-" + tone}>{label}</span>
            <h3>{p.name}</h3>
            <div class="origin">{p.origin} &middot; {p.roast}</div>

            <div class="meters">
              <div class="meter">
                <span>Pahit</span>
                <div class="dots">{[0,1,2,3,4].map(i=>(<b class={i < dots(p.intensity.pahit) ? 'on':''}></b>))}</div>
              </div>
              <div class="meter">
                <span>Asam</span>
                <div class="dots">{[0,1,2,3,4].map(i=>(<b class={i < dots(p.intensity.asam) ? 't on':'t'}></b>))}</div>
              </div>
            </div>

            <p class="blurb">{blurb}</p>

            <div class="price">
              {mp && (<span class="mp">{fmt(mp)}</span>)}
              <span class="now">{fmt(p.prices[250])}</span>
              <span class="per">/250gr</span>
            </div>
            <div class="cups">250gr bisa diseduh untuk &plusmn;25 gelas</div>

            <span class="buy">Pesan {p.name} <Icon name="arrow-right" /></span>
          </div>
        </a>
      ))}
    </section>

    <!-- Buat yang ketiganya kurang cocok: langsung ke katalog beranda, bukan ke
         kuis. Yang sudah menolak tiga pilihan konkret tidak perlu ditanyai lagi. -->
    <section class="lain">
      <a class="lainbtn" id="lainBtn" href="/">Temukan kopi lainnya <Icon name="arrow-right" /></a>
    </section>

    <section class="proof">
      <h2>Sudah dipercaya ribuan pembeli</h2>
      <p class="psub">Toko resmi aktif di TikTok Shop &amp; Shopee. Geser untuk lihat ulasan pembeli 👉</p>
      <div class="testi-track">
        {testis.map(src => (<div class="testi-card"><img src={src} loading="lazy" alt="Testimoni pelanggan Kopi Bing" /></div>))}
      </div>
    </section>

    <section class="ragu">
      <h2>Masih ragu? Takut kami tipu-tipu? 😌</h2>
      <p>Tenang. Kami <b>live di TikTok setiap hari</b> (@kopibing_), total 60 ribu+ followers di semua sosmed. Kalau ada pesanan bermasalah, kamu bisa langsung mampir komplain di live. Ini yang bikin ribuan orang berani order.</p>
    </section>

  </div>

  <style>
    .lp{ max-width:1000px; padding-top:16px; padding-bottom:30px; color:var(--tinta); }
    .logo-top{ text-align:center; margin:4px 0 16px; }
    .logo-top img{ width:56px; height:56px; border-radius:50%; }
    .cartfab{ position:fixed; top:14px; right:14px; z-index:20; display:flex; align-items:center; gap:7px;
      background:var(--birutua); color:#fff; font-size:17px; line-height:1; padding:10px 13px;
      border-radius:999px; box-shadow:0 4px 14px rgba(15,42,55,.25); text-decoration:none; transition:transform var(--dur-1) var(--ease); animation:kb-pop var(--dur-3) var(--ease-pantul) backwards; }
    .cartfab :global(.ik){ width:19px; height:19px; }
    .cartfab:active{ transform:scale(.92); }
    .cartfab .fabn{ background:var(--kuning); color:var(--birutua); font-size:12px; font-weight:800; min-width:19px;
      height:19px; border-radius:10px; display:flex; align-items:center; justify-content:center; padding:0 5px; }

    .hero{ text-align:center; max-width:640px; margin:0 auto 22px; }
    .hero h1{ font-size:28px; line-height:1.22; font-weight:800; color:var(--tinta); }
    .hero .sub{ color:var(--isi); font-size:15px; line-height:1.65; margin-top:12px; font-weight:500; }
    .hero .sub b{ font-weight:800; color:var(--tinta); }

    .cards{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .card{ background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; display:flex; flex-direction:column;
      transition:transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease); }
    @media(hover:hover) and (pointer:fine){
      .card:hover{ transform:translateY(-3px); box-shadow:0 10px 24px rgba(31,115,150,.14); border-color:var(--garisk); }
      .card:hover .imgs img{ transform:scale(1.04); }
    }
    .card:active{ transform:scale(.985); transition-duration:.08s; }
    .imgs{ overflow:hidden; }
    .imgs img{ transition:transform var(--dur-3) var(--ease); }
    .body{ padding:14px 15px 16px; display:flex; flex-direction:column; flex:1; }
    .body h3{ font-size:18px; font-weight:800; color:var(--tinta); }
    .origin{ color:var(--redup); font-size:11px; font-weight:600; letter-spacing:.04em; margin-top:2px; }
    .dots{ display:flex; gap:5px; }
    .dots b{ width:12px; height:12px; border-radius:50%; border:1.5px solid var(--garisk); background:var(--kabut); }
    .dots b.on{ background:var(--biru); border-color:var(--biru); }
    .blurb{ color:var(--isi); font-size:13px; line-height:1.6; flex:1; font-weight:500; }
    .price{ display:flex; align-items:baseline; gap:8px; margin:13px 0 4px; flex-wrap:wrap; }
    .price .mp{ color:var(--redup); font-size:13px; text-decoration:line-through; font-weight:500; }
    .price .now{ color:var(--biru); font-size:23px; font-weight:800; }
    .price .per{ color:var(--redup); font-size:12px; font-weight:600; }
    .cups{ color:var(--redup); font-size:12px; font-weight:500; margin-bottom:12px; }
    .buy{ margin-top:auto; display:flex; align-items:center; justify-content:center; gap:6px; height:46px; padding:0 12px; text-align:center; border-radius:var(--r-tombol);
      font-size:14px; font-weight:700; background:#fff; color:var(--birutua); border:1.5px solid var(--birutua); transition:transform var(--dur-1) var(--ease); }
    .buy :global(.ik){ width:17px; height:17px; }
    .card.utama .buy{ background:var(--kuning); border-color:var(--kuning); }
    .card:active .buy{ transform:scale(.97); }

    .proof{ text-align:center; margin:40px 0 0; }
    .proof h2, .ragu h2{ font-size:22px; font-weight:800; color:var(--tinta); }
    .psub{ color:var(--isi); font-size:14px; margin:8px auto 18px; max-width:520px; font-weight:500; }
    .testi-track{ display:flex; align-items:flex-start; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; padding-bottom:12px; scrollbar-width:thin; }
    .testi-card{ flex:0 0 auto; width:300px; scroll-snap-align:start; background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; }
    .testi-card img{ width:100%; display:block; }

    .ragu{ text-align:center; background:var(--kabut); border-radius:16px; padding:26px 22px; margin:40px 0 0; }
    .ragu p{ color:var(--isi); font-size:15px; line-height:1.7; max-width:580px; margin:12px auto 0; font-weight:500; }
    .ragu p b{ color:var(--tinta); font-weight:800; }

    .heroilu{ margin:0 -16px 18px; background:var(--kabut); overflow:hidden; height:130px; border-radius:0 0 var(--r-kartu) var(--r-kartu); }
    .heroilu img{ width:100%; height:100%; object-fit:cover; display:block; }
    .imgs{ background:var(--kabut); aspect-ratio:1/1; }
    .imgs img{ width:100%; height:100%; object-fit:contain; display:block; }
    .lvl{ align-self:flex-start; font-size:11px; font-weight:800; letter-spacing:.05em; padding:5px 10px; border-radius:7px; margin-bottom:9px; }
    .lvl.l-pahit{ background:var(--kuning); color:var(--birutua); }
    .lvl.l-asam{ background:var(--kabut); color:var(--biru); }
    .lvl.l-wine{ background:var(--kabut); color:var(--birutua); }
    .meters{ margin:10px 0; display:flex; flex-direction:column; gap:6px; }
    .meter{ display:flex; align-items:center; gap:9px; }
    .meter span{ font-size:11px; font-weight:700; color:var(--redup); width:34px; }
    .dots b.t.on{ background:var(--biru); border-color:var(--biru); }

    .lain{ text-align:center; margin:28px 0 0; }
    .lainbtn{ display:inline-flex; align-items:center; justify-content:center; gap:6px; height:46px; border:1.5px solid var(--birutua); color:var(--birutua); background:#fff;
      border-radius:var(--r-tombol); padding:0 26px; font-size:15px; font-weight:700; text-decoration:none; transition:transform var(--dur-1) var(--ease); }
    .lainbtn :global(.ik){ width:17px; height:17px; }
    .lainbtn:active{ transform:scale(.97); }

    @media(max-width:720px){
      .cards{ grid-template-columns:1fr; gap:14px; }
      .card{ flex-direction:row; align-items:stretch; }
      /* Kotak gambar tetap 1:1 dan menempel ke atas supaya contain tidak menyisakan pita lebar. */
      .imgs{ width:150px; flex-shrink:0; align-self:flex-start; }
      .hero h1{ font-size:24px; }
      .testi-card{ width:250px; }
    }
    @media(max-width:440px){
      .card{ flex-direction:column; }
      .imgs{ width:100%; aspect-ratio:1/1; }
    }
  </style>

  <script>
    import { trackMeta } from '../data/scalev.js';

    // Tombol keranjang cuma muncul kalau memang sudah ada isinya, biar halaman
    // iklan tetap bersih buat pengunjung baru.
    function syncFab(){
      try{
        const n=JSON.parse(localStorage.getItem('kb_cart')||'[]').reduce(function(s,i){ return s+i.qty; },0);
        const fab=document.getElementById('cartFab');
        if(!fab) return;
        document.getElementById('cartFabN').textContent=n;
        fab.style.display = n>0 ? 'flex' : 'none';
      }catch(e){}
    }
    syncFab();
    window.addEventListener('storage',syncFab);
    window.addEventListener('pageshow',syncFab);

    // Corong halaman iklan. Tanpa ini isi halaman jadi kotak hitam: Meta cuma
    // melaporkan berapa yang mendarat, bukan berapa yang benar-benar memilih.
    // Parameter `lp` sengaja dibawa supaya pola ini bisa dipakai ulang di /pahit.
    // metaEvent memakai keepalive, jadi aman ditembakkan tepat sebelum pindah halaman.
    function lpTrack(name, params){
      const id=name.toLowerCase()+'_'+Date.now()+'_'+Math.random().toString(36).slice(2);
      try{ trackMeta(name, Object.assign({ lp:'gayo' }, params), id, {}); }catch(e){}
    }

    document.querySelectorAll('.card').forEach(function(a){
      a.addEventListener('click', function(){
        lpTrack('LPPilihProduk', {
          content_ids:[a.dataset.slug], content_type:'product', posisi:Number(a.dataset.pos),
        });
      });
    });

    const lain=document.getElementById('lainBtn');
    if(lain) lain.addEventListener('click', function(){ lpTrack('LPKeKatalog',{}); });
  </script>
</Base>
