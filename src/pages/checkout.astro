---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import { products } from '../data/products.js';
import Icon from '../components/Icon.astro';

const CATALOG = Object.fromEntries(products.map(p => [p.slug, { n: p.name, p: p.prices }]));

// Logo metode bayar di public/img/bayar/. Hanya berkas yang benar-benar ada yang dipakai;
// selebihnya tampil sebagai lencana teks, jadi tidak pernah ada gambar rusak.
// Transfer bank memakai logo BCA karena rekening tujuannya BCA.
const PAYLOGO_FILE = { qris:'qris', bank_transfer:'bca', cod:'cod', va_bca:'bca', va_bni:'bni', va_bri:'bri', va_bsi:'bsi', va_mandiri:'mandiri' };
const PAYLOGO = Object.fromEntries(Object.entries(PAYLOGO_FILE)
  .filter(([, f]) => fs.existsSync(path.join(process.cwd(), 'public/img/bayar', f + '.svg')))
  .map(([code, f]) => [code, '/img/bayar/' + f + '.svg']));
const kurirDir = path.join(process.cwd(), 'public/img/kurir');
const KURIRLOGO = fs.existsSync(kurirDir) ? Object.fromEntries(fs.readdirSync(kurirDir).filter(f => /\.(svg|png|webp)$/.test(f)).map(f => [f.replace(/\.[^.]+$/, '').toLowerCase(), '/img/kurir/' + f])) : {};
---
<script is:inline define:vars={{ CATALOG, PAYLOGO, KURIRLOGO }}>window.KB_CATALOG = CATALOG; window.KB_PAYLOGO = PAYLOGO; window.KB_KURIRLOGO = KURIRLOGO;</script>
<Base title="Checkout — Toko Kopi Bing" description="Selesaikan pesanan kopimu di Toko Kopi Bing." noindex={true}>
  <div class="wrap cop" id="formView">
    <a class="back" id="backLink" href="/keranjang"><Icon name="arrow-left" /><span>Kembali ke keranjang</span></a>
    <h1>Checkout</h1>

    <section class="kar" data-muncul>
      <div class="kh"><span class="no">1</span><h2>Kirim ke mana?</h2></div>
      <label class="lb" for="locSearch">Kecamatan atau kota</label>
      <div class="loc">
        <input class="fld" id="locSearch" placeholder="Ketik kecamatan / kota (min 3 huruf)" autocomplete="off" />
        <div id="locResults" class="locres" style="display:none"></div>
      </div>
      <div id="locPicked" class="picked" style="display:none"><Icon name="map-pin" /><span id="locPickedTxt"></span></div>
      <select class="fld" id="postal" style="display:none"></select>
    </section>

    <section class="kar" id="courierWrap" data-muncul>
      <div class="kh"><span class="no">2</span><h2>Pilih kurir</h2></div>
      <div class="courier" id="courier"><div class="note ktunggu">Ketik kecamatan di atas, ongkir tiap kurir langsung muncul di sini.</div></div>
    </section>

    <section class="kar" data-muncul>
      <div class="kh"><span class="no">3</span><h2>Data penerima</h2></div>
      <label class="lb" for="nama">Nama penerima</label>
      <input class="fld" id="nama" placeholder="Nama lengkap" autocomplete="name" />
      <label class="lb" for="wa">Nomor WhatsApp</label>
      <input class="fld" id="wa" placeholder="Nomor WhatsApp (contoh 08123456789)" inputmode="tel" autocomplete="tel" />
      <label class="lb" for="alamat">Alamat rumah</label>
      <input class="fld" id="alamat" placeholder="Nama jalan, no rumah, RT/RW, patokan" autocomplete="street-address" />
    </section>

    <section class="kar" data-muncul>
      <div class="kh"><span class="no">4</span><h2>Metode pembayaran</h2></div>
      <div class="paylist" id="paymethods"><div class="note">Memuat metode pembayaran...</div></div>
    </section>

    <section class="kar summary" data-muncul>
      <div class="pt">Ringkasan pesanan</div>
      <div id="items"></div>
      <div class="line"></div>
      <div class="row"><span id="subLabel">Subtotal</span><span id="subtotal">Rp 0</span></div>
      <div class="row"><span>Ongkir</span><span id="ship">-</span></div>
      <div class="row total"><span>Total bayar</span><span id="total">Rp 0</span></div>
    </section>

    <button class="btn btn-kuning full" id="payBtn" disabled>Buat pesanan &amp; bayar</button>
    <p class="note" id="payNote">Pilih wilayah &amp; kurir, isi data, lalu pilih metode bayar.</p>
  </div>

  <!-- Langkah konfirmasi khusus COD. Pesanan BELUM dibuat waktu halaman ini tampil;
       order baru dikirim ke Scalev setelah tombol "Ya, saya siap bayar" ditekan.
       Alasannya: follow-up masih memakai nomor Scalev, jadi membatalkan pesanan COD
       yang sudah telanjur jalan itu mahal - lebih baik disaring sebelum dibuat. -->
  <div class="wrap cop codv" id="codView" style="display:none">
    <a class="back" id="codBack" href="#"><Icon name="arrow-left" /><span>Ubah pesanan</span></a>
    <h1>Cek dulu sebelum lanjut</h1>
    <p class="lead">Kamu memilih <b>bayar di tempat (COD)</b>. Uangnya dibayarkan tunai ke kurir waktu paket sampai, bukan sekarang.</p>

    <div class="bigamt">
      <span>Yang harus disiapkan</span>
      <b id="codTotal">Rp 0</b>
      <small>sudah termasuk ongkir</small>
    </div>

    <!-- Tombol utama sengaja ditaruh tepat di bawah nominal, sebelum peringatan dan
         rincian: pembeli harus langsung tahu apa yang mesti ditekan tanpa menggulir. -->
    <button class="btn btn-kuning full" id="codYes">Ya, saya siap bayar <span id="codBtnAmt"></span> ke kurir</button>
    <p class="note" id="codNote">Pesanan baru dibuat setelah kamu menekan tombol di atas.</p>

    <div class="kar summary">
      <div class="pt">Dikirim ke</div>
      <div class="dest" id="codDest"></div>
      <div class="line"></div>
      <div class="pt">Pesanan</div>
      <div id="codItems"></div>
      <div class="line"></div>
      <div class="row"><span>Subtotal</span><span id="codSub">Rp 0</span></div>
      <div class="row"><span>Ongkir</span><span id="codShip">Rp 0</span></div>
      <div class="row total"><span>Bayar ke kurir</span><span id="codTotal2">Rp 0</span></div>
    </div>

    <button class="btn btn-garis full" id="codEdit">Ubah dulu pesanan saya</button>

    <a class="wabtn" id="codWa" target="_blank" rel="noopener">
      <Icon name="whatsapp" />
      <span>Chat admin jika ada kendala</span>
    </a>
  </div>

  <style is:global>
    .cop{ max-width:600px; margin:0 auto; padding:16px 16px 10px; }
    .cop .back{ display:inline-flex; align-items:center; gap:5px; color:var(--biru); font-size:13px; font-weight:600; margin-bottom:12px; }
    /* Langkah COD tampil dari display:none: animasinya otomatis jalan tiap kali dibuka. */
    #codView{ animation:kb-naik var(--dur-3) var(--ease) backwards; }
    .cop h1{ font-size:24px; font-weight:800; color:var(--tinta); margin-bottom:16px; }
    .cop .kar{ background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); padding:18px; margin-bottom:14px; }
    .cop .kh{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
    .cop .kh h2{ font-size:16px; font-weight:700; color:var(--tinta); margin:0; }
    .cop .no{ width:24px; height:24px; border-radius:12px; background:var(--birutua); color:#fff; font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center; flex:none; }
    .cop .lb{ display:block; font-size:12px; font-weight:600; color:var(--redup); margin:0 0 6px; }
    .cop .fld{ width:100%; background:#fff; border:1.5px solid var(--garis); border-radius:12px; padding:13px 14px; font-family:inherit; font-size:15px; color:var(--tinta); margin-bottom:12px; transition:border-color .2s var(--ease), box-shadow .2s var(--ease); }
    .cop .fld:last-child{ margin-bottom:0; }
    .cop .fld:focus{ outline:none; border-color:var(--biru); box-shadow:0 0 0 3px rgba(31,115,150,.15); }
    .cop .fld.salah{ border-color:var(--merah); animation:kbGetar .35s var(--ease); }
    @keyframes kbGetar{ 0%,100%{transform:translateX(0)} 20%{transform:translateX(-5px)} 40%{transform:translateX(5px)} 60%{transform:translateX(-3px)} 80%{transform:translateX(3px)} }
    .cop .loc{ position:relative; }
    .cop .locres{ position:absolute; top:52px; left:0; right:0; background:#fff; border:1px solid var(--garisk); border-radius:12px; z-index:5; overflow:hidden; max-height:230px; overflow-y:auto; box-shadow:0 8px 24px rgba(15,42,55,.12); transform-origin:top center; animation:kb-turun var(--dur-2) var(--ease) backwards; }
    .cop .locres div{ padding:12px 14px; font-size:14px; color:var(--tinta); cursor:pointer; border-bottom:1px solid var(--kabut); transition:background var(--dur-1); }
    .cop .locres div:hover, .cop .locres div:active{ background:var(--kabut); }
    .cop .picked{ display:flex; align-items:flex-start; gap:7px; background:var(--kabut); border-radius:10px; padding:10px 13px; font-size:13px; font-weight:500; color:var(--birutua); margin-bottom:12px; animation:kb-naik var(--dur-2) var(--ease) backwards; }
    .cop .picked .ik{ width:16px; height:16px; margin-top:1px; color:var(--biru); }
    .cop .courier .crow.kur{ display:grid; grid-template-columns:auto 1fr; grid-template-rows:auto auto; align-items:center; gap:4px 8px; text-align:left; }
    .cop .klogo{ grid-column:1 / -1; height:22px; display:flex; align-items:center; font-size:13px; font-weight:800; letter-spacing:.2px; }
    .cop .klogo img{ height:100%; width:auto; max-width:90px; object-fit:contain; }
    .cop .courier .crow.kur .cl{ grid-column:1 / -1; }
    .cop .courier .crow.kur .cc{ grid-column:1 / -1; }
    .cop .ktunggu{ grid-column:1 / -1; background:var(--kabut); color:var(--birutua); border-radius:10px; padding:12px 14px; font-size:13px; font-weight:600; }
    .cop .kskel{ height:84px; border-radius:12px; background:linear-gradient(90deg,var(--kabut) 0%,#F4F8FA 50%,var(--kabut) 100%); background-size:200% 100%; animation:kb-kilap 1.1s linear infinite; }
    @keyframes kb-kilap{ to{ background-position:-200% 0; } }
    .cop .courier{ display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; }
    .cop .crow{ position:relative; display:flex; flex-direction:column; align-items:flex-start; gap:2px; background:#fff; border:1.5px solid var(--garisk); border-radius:12px; padding:12px 13px; cursor:pointer; font-family:inherit; text-align:left; color:var(--tinta); transition:background .2s var(--ease), border-color .2s var(--ease), color .2s var(--ease), box-shadow .2s var(--ease); }
    @media(hover:hover) and (pointer:fine){ .cop .crow:hover{ border-color:var(--biru); } }
    .cop .courier .crow.kur{ animation:kb-naik var(--dur-2) var(--ease) backwards; }
    .cop .courier .crow.kur:nth-child(2){ animation-delay:40ms; } .cop .courier .crow.kur:nth-child(3){ animation-delay:80ms; } .cop .courier .crow.kur:nth-child(n+4){ animation-delay:120ms; }
    .cop .crow.on{ background:var(--biru); border-color:var(--biru); color:#fff; box-shadow:0 4px 12px rgba(31,115,150,.28); }
    .cop .cl{ display:flex; flex-direction:column; align-items:flex-start; font-size:14px; font-weight:700; }
    .cop .cl small{ color:var(--redup); font-size:11px; margin-top:3px; font-weight:400; transition:color .2s var(--ease); }
    .cop .cc{ font-size:12px; font-weight:600; white-space:nowrap; }
    .cop .crow.on .cl small{ color:rgba(255,255,255,.85); }
    .cop .paylist{ display:flex; flex-direction:column; gap:10px; }
    .cop .paylist .crow{ display:grid; grid-template-columns:22px 1fr; column-gap:12px; row-gap:6px; align-items:start; width:100%; padding:14px; border-color:var(--garis); }
    .cop .paylist .crow::before{ content:''; grid-row:1 / span 2; width:20px; height:20px; border-radius:50%; border:1.5px solid var(--garisk); background:#fff; box-sizing:border-box; margin-top:1px; transition:border-color .2s var(--ease), border-width .2s var(--ease); }
    .cop .paylist .crow.on{ background:var(--kabut); border-color:var(--biru); color:var(--tinta); box-shadow:none; }
    .cop .paylist .crow.on::before{ border:6px solid var(--biru); }
    .cop .paylist .crow .cl{ grid-column:2; font-weight:700; color:var(--tinta); }
    .cop .paylist .crow .cl small{ color:var(--redup); }
    .cop .paylist .crow.on .cl small{ color:var(--isi); }
    .cop .paylogo{ grid-column:2; display:flex; align-items:center; height:24px; justify-self:start; }
    .cop .paylogo img{ height:100%; width:auto; max-width:90px; object-fit:contain; display:block; }
    .cop .paylogo.txt{ font-size:12px; font-weight:800; color:var(--birutua); letter-spacing:.3px; }
    .cop .summary{ margin-top:0; }
    .cop .pt{ color:var(--tinta); font-size:15px; font-weight:700; margin-bottom:14px; }
    .cop #items .ci, .cop #codItems .ci{ display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding:11px 0; border-top:1px solid var(--kabut); }
    .cop #items .ci:first-child, .cop #codItems .ci:first-child{ border-top:none; padding-top:0; }
    .cop .cnm{ font-size:14px; font-weight:600; color:var(--tinta); line-height:1.35; }
    .cop .cno{ color:var(--redup); font-size:12px; margin-top:3px; }
    .cop .cip{ font-size:14px; color:var(--tinta); white-space:nowrap; font-weight:600; }
    .cop .line{ height:1px; background:var(--garis); margin:12px 0 14px; }
    .cop .row{ display:flex; justify-content:space-between; font-size:14px; color:var(--redup); margin-bottom:10px; }
    .cop .row.total{ font-size:20px; color:var(--biru); font-weight:800; padding-top:14px; margin-bottom:0; border-top:1px solid var(--garis); }
    .cop .row.total span:first-child{ font-size:15px; font-weight:700; color:var(--tinta); align-self:center; }
    .cop .btn.full{ display:flex; width:100%; margin-top:4px; }
    .cop .btn:disabled{ opacity:.5; cursor:not-allowed; }
    .cop .btn.memuat{ position:relative; opacity:.9; cursor:progress; }
    .cop .btn.memuat::before{ content:''; width:16px; height:16px; margin-right:9px; border-radius:50%; border:2px solid rgba(15,42,55,.25); border-top-color:var(--tinta); animation:kbPutar .7s linear infinite; flex:none; }
    @keyframes kbPutar{ to{ transform:rotate(360deg) } }
    .cop .note{ color:var(--redup); font-size:12px; text-align:center; margin-top:12px; }
    .cop .note.err{ color:var(--merah); }

    .codv .lead{ color:var(--isi); font-size:14px; line-height:1.65; margin-bottom:18px; }
    .codv .bigamt{ background:var(--kabut); border:1px solid var(--garis); border-radius:var(--r-kartu); padding:18px; text-align:center; }
    .codv .bigamt span{ display:block; color:var(--redup); font-size:12px; }
    .codv .bigamt b{ display:block; color:var(--birutua); font-size:30px; font-weight:800; margin:5px 0 3px; }
    .codv .bigamt small{ color:var(--redup); font-size:11px; }
    .codv .summary{ margin-top:14px; }
    .codv .dest{ color:var(--tinta); font-size:13px; line-height:1.6; }
    .codv .dest b{ font-weight:700; }
    .codv .btn.full{ margin-top:18px; }
    .codv .btn-garis.full{ margin-top:10px; }
    .codv .wabtn{ display:flex; align-items:center; justify-content:center; gap:9px; background:#25995a; color:#fff;
      border-radius:var(--r-tombol); padding:13px; font-size:14px; font-weight:600; margin-top:10px; transition:background .2s var(--ease); }
    .codv .wabtn:hover{ background:#1F8850; }
    .codv .wabtn svg{ width:18px; height:18px; flex-shrink:0; }
    @media (min-width:900px){ .cop{ max-width:720px; } }
  </style>


  <script>
    import { pruneCart, toItems, searchLocations, postalCodes, paymentMethods, shippingOptions, createOrder, patchOrder, metaEvent, fbAttribution, iklanTerakhir, trackMeta, trackPixelOnly, analyticsItems, stashOrderMeta, sweepOrderMeta, markPurchaseFired, safeLp } from '../data/scalev.js';

    // --- Pengukur langkah checkout (Build DNA, 24 Sep 2026) -----------------
    // InitiateCheckout di bawah menembak TIAP halaman dimuat (termasuk muat ulang), jadi
    // tidak bisa dipakai menghitung berapa orang berhenti di langkah mana. Event CO_* ini
    // mengisi celahnya: satu kali per langkah per tab (sessionStorage), jadi muat ulang
    // tidak menggandakan. Hanya pixel browser - ini alat ukur, bukan sinyal optimasi,
    // dan tidak ada ad set yang dioptimasi ke event ini.
    // Dibersihkan sesudah order berhasil dibuat, supaya checkout berikutnya di tab yang
    // sama terhitung lagi.
    const CO_LANGKAH=['CO_Buka','CO_Data','CO_Wilayah','CO_Kurir','CO_Klik'];
    function langkah(nama, params){
      try{
        const k='kb_co_'+nama;
        if(sessionStorage.getItem(k)) return;
        sessionStorage.setItem(k,'1');
      }catch(e){ /* sessionStorage diblokir: tetap kirim, lebih baik dobel daripada hilang */ }
      trackPixelOnly(nama, params||{}, 'co_'+nama+'_'+Date.now()+'_'+Math.random().toString(36).slice(2));
    }
    function resetLangkah(){ try{ CO_LANGKAH.forEach(function(n){ sessionStorage.removeItem('kb_co_'+n); }); }catch(e){} }
    // CO_Gagal TIDAK dibatasi sekali per tab: tiap kegagalan penting dihitung.
    // Pesan error dari Scalev dipotong dan angka panjang dibuang (jaga-jaga nomor HP).
    function gagal(tahap, err){
      const pesan=String((err && err.message) || err || '').replace(/\d{5,}/g,'#').slice(0,80);
      trackPixelOnly('CO_Gagal', {tahap:tahap, pesan:pesan}, 'co_gagal_'+Date.now()+'_'+Math.random().toString(36).slice(2));
    }

    const LP = safeLp(new URLSearchParams(location.search).get('lp'));
    if(LP){ const bl=document.getElementById('backLink'); if(bl){ bl.href='/'+LP; bl.querySelector('span').textContent='Kembali ke pilihan'; } }
    sweepOrderMeta();

    const fmt=(n)=>"Rp "+Number(n).toLocaleString('id-ID');
    const params=new URLSearchParams(location.search);
    const isBuynow = params.get('buynow')==='1';
    const cart = pruneCart(isBuynow ? JSON.parse(sessionStorage.getItem('kb_buynow')||'[]') : JSON.parse(localStorage.getItem('kb_cart')||'[]'), window.KB_CATALOG);
    if(isBuynow){ const bl=document.getElementById('backLink'); if(bl){ bl.querySelector('span').textContent='Lanjut belanja'; bl.href='/#katalog'; } }

    const $=(id)=>document.getElementById(id);
    let loc=null, chosenPostal=null, courier=null, ship=0, payMethod=null;

    const sub=cart.reduce((s,i)=>s+i.price*i.qty,0);
    if(!cart.length){ $('items').innerHTML='<div class="ci">Keranjang kosong</div>'; }
    else {
      $('items').innerHTML=cart.map(function(it){ const w=it.g>=1000?'1kg':it.g+'gr';
        return '<div class="ci"><div><div class="cnm">'+it.name+'</div><div class="cno">'+w+' &middot; '+it.grind+' &times; '+it.qty+'</div></div><div class="cip">'+fmt(it.price*it.qty)+'</div></div>'; }).join('');
    }
    $('subLabel').textContent='Subtotal ('+cart.reduce((s,i)=>s+i.qty,0)+' item)';
    $('subtotal').textContent=fmt(sub);
    $('total').textContent=fmt(sub);
    function gulir(el,t){ if(el.textContent===t) return; if(window.kbGulir){ try{ window.kbGulir(el,t); return; }catch(e){} } el.textContent=t; }
    if(cart.length) trackMeta('InitiateCheckout',{content_ids:cart.map(function(i){return String(i.vid||i.slug);}),content_type:'product',num_items:cart.reduce(function(s,i){return s+i.qty;},0),value:sub,currency:'IDR'}, 'ic_'+Date.now()+'_'+Math.random().toString(36).slice(2), {});
    if(cart.length) langkah('CO_Buka', {cara:isBuynow?'beli_langsung':'keranjang', num_items:cart.reduce(function(s,i){return s+i.qty;},0), value:sub, currency:'IDR', lp:LP||''});

    const PAY_LABEL={ bank_transfer:'Transfer bank', qris:'QRIS', va:'Virtual Account', cod:'Bayar di tempat (COD)',
      invoice:'Virtual Account / E-Wallet', va_bca:'Virtual Account BCA', va_bni:'Virtual Account BNI', va_bri:'Virtual Account BRI',
      va_bsi:'Virtual Account BSI', va_mandiri:'Virtual Account Mandiri', dana:'DANA', ovo:'OVO', shopeepay:'ShopeePay' };
    const PAY_DESC={ bank_transfer:'Transfer ke rekening, dikonfirmasi otomatis', qris:'Scan pakai GoPay, OVO, Dana, m-banking', va:'BCA, BNI, Mandiri, dan bank lainnya', cod:'Bayar saat barang sampai',
      invoice:'Pilih VA bank atau e-wallet di halaman berikutnya', va_bca:'Bayar lewat m-BCA, ATM, atau internet banking', va_bni:'Bayar lewat m-banking atau ATM BNI',
      va_bri:'Bayar lewat BRImo atau ATM BRI', va_bsi:'Bayar lewat BSI Mobile atau ATM BSI', va_mandiri:'Bayar lewat Livin atau ATM Mandiri',
      dana:'Bayar lewat aplikasi DANA', ovo:'Bayar lewat aplikasi OVO', shopeepay:'Bayar lewat aplikasi Shopee' };
    // Teks cadangan di kotak logo, dipakai selama berkas logonya belum ada.
    const PAY_BADGE={ qris:'QRIS', bank_transfer:'BCA', cod:'COD', va_bca:'BCA', va_bni:'BNI', va_bri:'BRI', va_bsi:'BSI', va_mandiri:'mandiri',
      invoice:'VA', dana:'DANA', ovo:'OVO', shopeepay:'SPay' };
    // Urutan tampil. Metode di luar daftar ini ikut tampil, ditaruh paling bawah.
    //
    // PENTING: yang pertama juga menjadi pilihan DEFAULT - lihat `i===0` dan
    // `methods[0].code` di bawah. Jadi mengubah urutan di sini mengubah metode
    // yang dipakai mayoritas pelanggan, bukan sekadar tata letak.
    //
    // QRIS ditaruh paling depan sejak 15 Agustus 2026. Sebelumnya bank_transfer yang
    // default, dan hasilnya 132 dari 135 order (98%) memakai transfer bank manual
    // sepanjang 16 Jul - 14 Agu 2026, dengan 14% di antaranya tidak pernah terkonfirmasi.
    // Transfer bank butuh unggah bukti, dan itu yang gagal di browser dalam aplikasi
    // Facebook/Instagram - sumber semua order nyangkut yang sempat diperiksa satu per satu.
    // QRIS terverifikasi otomatis dan tidak butuh unggah apa pun.
    //
    // bank_transfer sengaja ditaruh kedua, bukan dibuang: masih mudah ditemukan bagi
    // yang memang memilihnya. Belum ada bukti QRIS lebih baik - sampelnya cuma 3 order
    // sebelum perubahan ini. Perubahan ini yang membuat pembandingnya ada.
    const PAY_ORDER=['qris','bank_transfer','cod','invoice','va_bca','va_bni','va_bri','va_bsi','va_mandiri','dana','ovo','shopeepay'];
    // Metode yang disembunyikan dari web (tetap aktif di Scalev untuk jalur WhatsApp/dashboard).
    const PAY_HIDE=[];
    // Saat dikembangkan di localhost, Scalev menolak permintaan dari browser (localhost sengaja
    // tidak ada di daftar origin yang diizinkan). Supaya alur checkout tetap bisa dicoba dari
    // awal sampai layar konfirmasi COD, mode dev memakai data contoh untuk metode bayar, wilayah,
    // kode pos, dan ongkir. Pembuatan order TIDAK diberi contoh: di localhost ia tetap gagal,
    // jadi tidak mungkin ada order sungguhan terbuat dari mesin pengembang.
    // `import.meta.env.DEV` bernilai false saat build produksi, jadi semua data contoh terbuang.
    const DEV_CONTOH = import.meta.env.DEV ? {
      bayar: ['qris','bank_transfer','cod','va_bca','va_bni','va_bri','va_bsi','va_mandiri'].map(function(code){ return { code: code, enabled: true }; }),
      wilayah: [{ id: 1, display: 'Cibeber, Kota Cilegon, Banten', subdistrict_name: 'Cibeber', city_name: 'Kota Cilegon', province_name: 'Banten' }],
      kodepos: ['42426'],
      ongkir: [
        { courier_code: 'ide', name: 'Reguler', etd: '1-2', cost: 9000,  courier_aggregator_code: 'lincah', courier_service_id: 0, warehouse_unique_id: 'dev' },
        { courier_code: 'jne', name: 'REG',     etd: '1-2', cost: 10500, courier_aggregator_code: 'lincah', courier_service_id: 0, warehouse_unique_id: 'dev' },
      ],
    } : null;
    async function atauContoh(janji, kunci){
      try{ return await janji; }
      catch(e){
        if(!import.meta.env.DEV) throw e;
        console.warn('[dev] Scalev menolak localhost - memakai data contoh: ' + kunci);
        return DEV_CONTOH[kunci];
      }
    }
    function loadPaymentMethods(){ return atauContoh(paymentMethods(), 'bayar'); }
    (async function loadPay(){
      try{
        const methods=(await loadPaymentMethods()).filter(m=>m.enabled!==false && PAY_HIDE.indexOf(m.code)<0)
          .sort((a,b)=>{ const ia=PAY_ORDER.indexOf(a.code), ib=PAY_ORDER.indexOf(b.code);
            return (ia<0?99:ia)-(ib<0?99:ib); });
        if(!methods.length){ $('paymethods').innerHTML='<div class="note err">Belum ada metode pembayaran aktif.</div>'; return; }
        const LOGO=window.KB_PAYLOGO||{};
        const logoTag=function(code){
          // Sengaja TIDAK loading="lazy": gambar malas yang belum punya ukuran (0x0) tidak pernah
          // dimuat browser, dan kotak logonya jadi kosong. Delapan SVG kecil, dimuat langsung saja.
          if(LOGO[code]) return '<span class="paylogo"><img src="'+LOGO[code]+'" alt="" width="50" height="26" /></span>';
          return '<span class="paylogo txt">'+(PAY_BADGE[code]||'')+'</span>';
        };
        $('paymethods').innerHTML=methods.map((m,i)=>'<button class="crow'+(i===0?' on':'')+'" data-code="'+m.code+'"><span class="cl">'+(PAY_LABEL[m.code]||m.label||m.code)+'<small>'+(PAY_DESC[m.code]||'')+'</small></span>'+logoTag(m.code)+'</button>').join('');
        payMethod=methods[0].code;
        $('paymethods').querySelectorAll('.crow').forEach(b=>b.addEventListener('click',function(){
          $('paymethods').querySelectorAll('.crow').forEach(x=>x.classList.remove('on'));
          this.classList.add('on'); payMethod=this.dataset.code; refreshPay();
        }));
        refreshPay();
      }catch(e){ $('paymethods').innerHTML='<div class="note err">Gagal memuat metode pembayaran.</div>'; gagal('metode_bayar', e); }
    })();

    let t=null;
    $('locSearch').addEventListener('input',function(){
      const q=this.value.trim(); clearTimeout(t);
      if(q.length<3){ $('locResults').style.display='none'; return; }
      t=setTimeout(async function(){
        try{
          const res=await atauContoh(searchLocations(q), 'wilayah'); const box=$('locResults');
          if(!res.length){ box.style.display='none'; return; }
          box.innerHTML=res.slice(0,8).map((r,i)=>'<div data-i="'+i+'">'+r.display+'</div>').join('');
          box._data=res; box.style.display='block';
        }catch(e){}
      },350);
    });
    $('locResults').addEventListener('click',async function(e){
      const d=e.target.closest('[data-i]'); if(!d) return;
      loc=this._data[+d.dataset.i]; this.style.display='none'; $('locSearch').value='';
      langkah('CO_Wilayah', {provinsi:loc.province_name||''});
      $('locPickedTxt').textContent=loc.display; $('locPicked').style.display='flex';
      resetCourier(); chosenPostal=null; const sel=$('postal');
      try{
        const codes=await atauContoh(postalCodes(loc.id), 'kodepos');
        if(codes && codes.length){
          const opts=codes.map(c=>{ const v=(typeof c==='string')?c:(c.postal_code||c.code||c); return '<option value="'+v+'">'+v+'</option>'; }).join('');
          sel.innerHTML=opts; chosenPostal=sel.options[0] ? sel.options[0].value : '';
        } else { chosenPostal=''; }
        sel.style.display='none';
        loadCouriers();
      }catch(e){ sel.style.display='none'; chosenPostal=''; }
    });
    $('postal').addEventListener('change',function(){ chosenPostal=this.value; if(chosenPostal){ loadCouriers(); } });

    function resetCourier(){ courier=null; ship=0; gulir($('ship'),'-'); gulir($('total'),fmt(sub)); $('courier').innerHTML='<div class="note ktunggu">Ketik kecamatan di atas, ongkir tiap kurir langsung muncul di sini.</div>'; $('courier')._opts=null; refreshPay(); }

    // Logo kurir: pakai /img/kurir/<kode>.svg kalau berkasnya ada (KB_KURIRLOGO), kalau tidak tulisan merek berwarna.
    const KURIR={ jne:['JNE','#0B3F8F'], jnt:['J&T','#E3001B'], 'j&t':['J&T','#E3001B'], ide:['ID Express','#C8102E'], idexpress:['ID Express','#C8102E'],
      sicepat:['SiCepat','#C8161D'], anteraja:['AnterAja','#E6007E'], sap:['SAP','#F15A22'], ninja:['Ninja','#C8102E'], pos:['POS','#F26B21'],
      lion:['Lion Parcel','#E31E24'], tiki:['TIKI','#003A8C'], wahana:['Wahana','#00A651'], sentral:['Sentral','#1D3C8F'], jtcargo:['J&T Cargo','#E3001B'] };
    function kurirLogo(code){
      const k=String(code||'').toLowerCase(), f=(window.KB_KURIRLOGO||{})[k];
      if(f) return '<span class="klogo"><img src="'+f+'" alt="" /></span>';
      const m=KURIR[k]||[k.toUpperCase(),'#133F52'];
      return '<span class="klogo txt" style="color:'+m[1]+'">'+m[0]+'</span>';
    }
    async function loadCouriers(){
      if(!loc) return;
      const wrap=$('courierWrap'), box=$('courier');
      wrap.style.display='block'; box.innerHTML='<div class="kskel"></div><div class="kskel"></div>';
      courier=null; ship=0; gulir($('ship'),'-'); gulir($('total'),fmt(sub)); refreshPay();
      try{
        let opts=await atauContoh(shippingOptions(toItems(cart), loc.id, chosenPostal, payMethod||'bank_transfer'), 'ongkir');
        opts=opts.filter(o=>String(o.courier_aggregator_code||'').toLowerCase()==='lincah');
        if(!opts.length){ box.innerHTML='<div class="note err">Kurir tidak tersedia untuk wilayah ini.</div>'; gagal('kurir_kosong', 'tidak ada kurir lincah'); return; }
        box.innerHTML=opts.map((o,i)=>'<button class="crow kur" data-i="'+i+'">'+kurirLogo(o.courier_code)+'<span class="cl">'+(o.name||o.service_code||'')+(o.etd?'<small>estimasi '+o.etd+' hari</small>':'')+'</span><span class="cc">'+fmt(o.cost)+'</span></button>').join('');
        box._opts=opts;
      }catch(err){ box.innerHTML='<div class="note err">'+(err.message||'Gagal menghitung ongkir.')+'</div>'; gagal('ongkir', err); }
    }

    $('courier').addEventListener('click',function(e){
      const b=e.target.closest('.crow'); if(!b || !this._opts) return;
      this.querySelectorAll('.crow').forEach(x=>x.classList.remove('on')); b.classList.add('on');
      courier=this._opts[+b.dataset.i]; ship=Number(courier.cost);
      gulir($('ship'),fmt(ship)); gulir($('total'),fmt(sub+ship));
      langkah('CO_Kurir', {kurir:String(courier.courier_code||''), ongkir:ship, value:sub+ship, currency:'IDR'});
      refreshPay();
    });

    function setNote(msg,err){ const n=$('payNote'); n.textContent=msg; n.classList.toggle('err',!!err); }
    function ready(){ return cart.length && $('nama').value.trim() && $('wa').value.trim() && $('alamat').value.trim() && loc && chosenPostal && courier && payMethod; }
    function refreshPay(){ const ok=ready(); $('payBtn').disabled=!ok; if(ok) setNote('Siap. Klik untuk buat pesanan.',false); }
    // CO_Data: ketiga isian terisi (WA minimal 9 digit). Ditembak saat pembeli berhenti
    // mengetik di salah satunya (blur), bukan tiap huruf.
    function cekData(){
      if($('nama').value.trim() && $('wa').value.replace(/\D/g,'').length>=9 && $('alamat').value.trim()) langkah('CO_Data', {});
    }
    ['nama','wa','alamat'].forEach(id=>{ $(id).addEventListener('input',function(){ this.classList.remove('salah'); refreshPay(); }); $(id).addEventListener('blur',cekData); });
    // Gaya saja: isian WA yang jelas keliru bergetar kecil. Tidak mengubah syarat tombol.
    $('wa').addEventListener('blur',function(){ const v=this.value.trim(); if(v && v.replace(/\D/g,'').length<9){ this.classList.remove('salah'); void this.offsetWidth; this.classList.add('salah'); } });

    // --- Langkah konfirmasi COD -------------------------------------------
    // Ditampilkan sebelum order dikirim ke Scalev, bukan sesudah. Kalau pembeli
    // mundur di sini, tidak ada pesanan yang perlu dibatalkan siapa pun.
    const WA_ADMIN='https://wa.me/6285161941214?text=';
    function showCodConfirm(){
      const total=sub+ship;
      // Label dibangun ulang: kalau percobaan sebelumnya gagal, isi tombolnya sempat diganti teks biasa.
      $('codYes').innerHTML='Ya, saya siap bayar <span id="codBtnAmt"></span> ke kurir';
      $('codYes').disabled=false;
      $('codNote').textContent='Pesanan baru dibuat setelah kamu menekan tombol di atas.';
      $('codNote').classList.remove('err');
      $('codTotal').textContent=fmt(total);
      $('codTotal2').textContent=fmt(total);
      $('codBtnAmt').textContent=fmt(total);
      $('codSub').textContent=fmt(sub);
      $('codShip').textContent=fmt(ship);
      $('codItems').innerHTML=$('items').innerHTML; // ringkasan produk, bukan input pelanggan

      // Data penerima diisi lewat DOM, bukan innerHTML - isinya ketikan pelanggan.
      const d=$('codDest'); d.textContent='';
      const nm=document.createElement('b'); nm.textContent=$('nama').value.trim(); d.appendChild(nm);
      [$('wa').value.trim(), $('alamat').value.trim(), (loc.display||'')+' '+chosenPostal].forEach(function(t){
        d.appendChild(document.createElement('br'));
        d.appendChild(document.createTextNode(t));
      });

      $('codWa').href=WA_ADMIN+encodeURIComponent('Halo Kopi Bing, saya mau tanya soal pesanan COD atas nama '+$('nama').value.trim());
      $('formView').style.display='none';
      $('codView').style.display='block';
      window.scrollTo(0,0);
      try{ history.pushState({cod:1},'',location.pathname+location.search+'#konfirmasi-cod'); }catch(e){}
    }
    function hideCodConfirm(){
      $('codView').style.display='none';
      $('formView').style.display='block';
      window.scrollTo(0,0);
    }
    $('codEdit').addEventListener('click',function(){ try{ history.back(); }catch(e){ hideCodConfirm(); } });
    $('codBack').addEventListener('click',function(e){ e.preventDefault(); try{ history.back(); }catch(e2){ hideCodConfirm(); } });
    window.addEventListener('popstate',function(){ if($('codView').style.display!=='none') hideCodConfirm(); });
    $('codYes').addEventListener('click',function(){
      submitOrder(this,'Ya, saya siap bayar '+fmt(sub+ship)+' ke kurir',$('codNote'));
    });

    $('payBtn').addEventListener('click',function(){
      if(!ready()) return;
      langkah('CO_Klik', {metode:payMethod, value:sub+ship, currency:'IDR'});
      if(payMethod==='cod'){ showCodConfirm(); return; }
      submitOrder(this,'Buat pesanan & bayar',$('payNote'));
    });

    async function submitOrder(btn, idleLabel, noteEl){
      if(!ready()) return;
      btn.disabled=true; btn.textContent='Membuat pesanan...'; btn.classList.add('memuat');
      const fail=function(msg){ btn.disabled=false; btn.classList.remove('memuat'); btn.textContent=idleLabel;
        noteEl.textContent=msg; noteEl.classList.add('err'); };
      try{
        const phone=$('wa').value.replace(/\D/g,'');
        const payload={
          items: toItems(cart),
          customer_name: $('nama').value.trim(),
          customer_email: phone+"@mail.kopibing.id",
          customer_phone: phone,
          shipping_address: $('alamat').value.trim(),
          shipping_location_id: loc.id,
          shipping_subdistrict: loc.subdistrict_name,
          shipping_postal_code: chosenPostal,
          courier_service_id: courier.courier_service_id,
          warehouse_unique_id: courier.warehouse_unique_id,
          courier_aggregator_code: courier.courier_aggregator_code || null,
          payment_method: payMethod
        };
        const order=await createOrder(payload);
        const pval = Number(order.gross_revenue || order.total_price || order.total || (sub+ship));
        const peid = String(order.order_id || order.secret_slug || Date.now())+'-OrderCreated-FORM';
        // Unique id diambil dari respons order; kalau tidak ada, jatuh ke id numerik dari cart.
        const ai=analyticsItems(order);
        const contentIds=ai.content_ids.length ? ai.content_ids : cart.map(function(i){return String(i.vid||i.slug);});
        const numItems=ai.num_items || cart.reduce(function(s,i){return s+i.qty;},0);
        const userData={ph:phone, ct:(loc&&loc.city_name)||undefined, st:(loc&&loc.province_name)||undefined,
                        external_id:order.customer_id?String(order.customer_id):undefined};
        const oid=String(order.order_id||order.secret_slug||'');
        try{ await trackMeta('OrderCreated', {content_ids:contentIds, content_type:'product', value:pval, currency:'IDR', num_items:numItems}, peid, userData, ai.items); }catch(e){}

        // Purchase. Payload order publik menyensor HP dan tidak memuat variant_id, jadi data
        // yang bagus dititipkan di sini supaya halaman pesanan bisa memakainya nanti.
        // Hanya dititipkan untuk metode yang Purchase-nya menyusul di halaman pesanan.
        // COD menembakkan Purchase di sini juga, jadi tidak perlu menyimpan HP pelanggan sama sekali.
        if(oid && payMethod!=='cod') stashOrderMeta(oid, {ids:contentIds, num:numItems, value:pval, ph:phone, ct:userData.ct, st:userData.st, ex:userData.external_id});

        // Titipkan penanda iklan ke server, supaya webhook Purchase nanti punya fbc/fbp/IP/user agent.
        // Webhook dipanggil server Scalev dan tidak pernah melihat browser pembeli, jadi ini
        // satu-satunya kesempatan mengambilnya. COD dilewati: Purchase-nya ditembakkan di sini
        // juga (lihat di bawah), lengkap dengan penanda, jadi webhook tidak perlu ikut campur.
        //
        // Sengaja TANPA await dan pakai keepalive: halaman langsung pindah setelah ini, dan
        // checkout tidak boleh melambat cuma demi pelengkap atribusi.
        //
        // Iklan yang terakhir diklik (`iklan`) ikut dititipkan untuk SEMUA metode bayar, termasuk
        // COD, supaya order lunas di Scalev bisa dihitung per ad set. Untuk COD hanya bagian iklan
        // yang disimpan (`cod:true`), penanda fbc/fbp/IP/UA tetap tidak dititipkan.
        if(oid){
          try{
            const at=fbAttribution();
            const cod=payMethod==='cod';
            fetch('/api/stash-attribution', {method:'POST', keepalive:true,
              headers:{'Content-Type':'application/json'},
              body:JSON.stringify(cod ? {order_id:oid, cod:true, iklan:iklanTerakhir()} : {order_id:oid, fbc:at.fbc, fbp:at.fbp, iklan:iklanTerakhir()})});
          }catch(e){}
        }
        // COD dibayar ke kurir, jadi konversinya dihitung saat order dibuat.
        // Metode lain: Purchase ditembakkan di halaman pesanan begitu pembayarannya benar-benar masuk.
        if(oid && payMethod==='cod'){
          try{
            await trackMeta('Purchase', {content_ids:contentIds, content_type:'product', value:pval, currency:'IDR', num_items:numItems}, oid+'-Purchase', userData, ai.items);
            markPurchaseFired(oid);
          }catch(e){}
        }
        try{ localStorage.removeItem('kb_cart'); sessionStorage.removeItem('kb_buynow'); }catch(e){}
        resetLangkah();
        // ?bayar=1 menandai "baru selesai checkout". Halaman pesanan memakainya untuk
        // melempar langsung ke halaman pembayaran Scalev pada metode e-payment, tanpa
        // ketukan tambahan. Kunjungan berikutnya (mis. dari link follow-up) tidak
        // ditandai, jadi pelanggan tetap bisa melihat detail pesanannya.
        const dest = order.public_order_url || order.payment_url;
        if(dest){ window.location.href = dest + (dest.indexOf('?')>=0 ? '&' : '?') + 'bayar=1'; }
        else { noteEl.textContent='Pesanan dibuat. Cek WhatsApp untuk instruksi pembayaran.'; noteEl.classList.remove('err'); }
      }catch(err){ gagal('buat_order', err); fail('Pesanan belum bisa dibuat. Coba cek lagi penulisan nomor WhatsApp dan alamatmu ya. Kalau masih belum bisa, hubungi kami lewat tombol WhatsApp di kanan atas.'); }
    }
  </script>
</Base>
