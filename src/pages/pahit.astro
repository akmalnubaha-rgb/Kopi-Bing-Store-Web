---
import Base from '../layouts/Base.astro';
import { products } from '../data/products.js';

// Tema "kopi pahit" — 3 pilihan robusta, diurut dari paling pahit.
// mp = harga referensi marketplace (Shopee/TikTok) buat anchor 250gr.
const picks = [
  { slug:"robusta-sidikalang", level:"PAHIT BANGET", meter:5, mp:94000, blurb:"Dark roast oily, pahitnya tebal & nendang. Buat yang cari pahit maksimal." },
  { slug:"robusta-temanggung", level:"PAHIT PAS",    meter:4, mp:94000, blurb:"Pahit pas, body bold dengan rasa coklat pekat sedikit manis. Mantap buat kopi susu & tubruk." },
  { slug:"robusta-gayo",       level:"PAHIT SEDANG", meter:3, mp:94000, blurb:"Pahit sedang, sama sekali nggak asem. Enak diminum harian tanpa gula." },
].map(x => ({ ...x, p: products.find(p => p.slug === x.slug) }));

const fmt = (n)=> "Rp " + n.toLocaleString('id-ID');
const testis = Array.from({length:15}, (_,i)=> '/img/testi/'+(i+1)+'.webp');
---
<Base title="3 Kopi Robusta Pahit Paling Laris — Kopi Bing" description="Tiga robusta paling pahit dan paling laris di Toko Kopi Bing." noindex={true} naked={true}>
  <div class="wrap lp" id="top">

    <!-- Halaman ini tanpa header (naked) supaya tidak ada pintu keluar ke beranda.
         Tapi pembeli yang sudah menaruh kopi di keranjang tetap butuh jalan ke sana,
         jadi tombolnya muncul di kanan atas begitu keranjang ada isinya. -->
    <a class="cartfab" id="cartFab" href="/keranjang?lp=pahit" style="display:none" aria-label="Keranjang">
      &#128722;<span class="fabn" id="cartFabN">0</span>
    </a>

    <div class="logo-top"><img src="/img/logo.png" alt="Kopi Bing" /></div>

    <section class="hero">
      <h1>Ini 3 Kopi Robusta Pahit Paling Laris!</h1>
      <p class="sub">Sudah terjual ribuan di TikTok Shop dan Shopee. Bisa request gilingan. Pilih selera pahitmu di bawah 👇</p>
    </section>

    <section class="cards" data-muncul>
      {picks.map(({p, level, mp, blurb, meter}, idx)=>(
        <a class={"card" + (idx===0 ? " utama" : "")} href={`/produk/${p.slug}?lp=pahit`}>
          <div class="imgs">
            <div class="imgtrack">
              {/* Kartu pertama adalah gambar terbesar di layar awal, jadi jangan ditunda. */}
              <div class="imgslide"><img src={`/img/${p.slug}-real.webp`} alt={`Foto asli ${p.name}`} loading={idx===0?"eager":"lazy"} fetchpriority={idx===0?"high":undefined} /></div>
              <div class="imgslide"><img src={`/img/${p.slug}.webp`} alt={p.name} loading="lazy" /></div>
            </div>
            <div class="idots"><b class="on"></b><b></b></div>
          </div>
          <div class="body">
            <span class={"lvl " + (meter>=5?'l3':meter===4?'l2':'l1')}>{level}</span>
            <h3>{p.name}</h3>
            <div class="origin">{p.origin}</div>
            <div class="meter">
              <span>Pahit</span>
              <div class="dots">{[0,1,2,3,4].map(i=>(<b class={i < meter ? 'on':''}></b>))}</div>
            </div>
            <p class="blurb">{blurb}</p>

            <div class="price">
              <span class="mp">{fmt(mp)}</span>
              <span class="now">{fmt(p.prices[250])}</span>
              <span class="per">/250gr</span>
            </div>
            <div class="cups">250gr bisa diseduh untuk ±25 gelas (tubruk)</div>

            <span class="buy">Pesan {p.name} →</span>
          </div>
        </a>
      ))}
    </section>

    <section class="proof">
      <h2>Sudah dipercaya ribuan pembeli</h2>
      <p class="psub">Toko resmi aktif di TikTok Shop &amp; Shopee. Geser untuk lihat ulasan pembeli 👉</p>
      <div class="testi-track">
        {testis.map(src => (<div class="testi-card"><img src={src} loading="lazy" alt="Testimoni pelanggan Kopi Bing" /></div>))}
      </div>
    </section>

    <section class="ragu">
      <h2>Masih ragu? Takut kami tipu-tipu? 😌</h2>
      <p>Tenang. Kami <b>live di TikTok setiap hari</b> (@kopibing_), total 60 ribu+ followers di semua sosmed. Kalau ada pesanan bermasalah, kamu bisa langsung mampir komplain di live. Ini yang bikin ribuan orang berani order.</p>
    </section>

  </div>

  <style>
    .lp{ max-width:1000px; padding-top:16px; padding-bottom:30px; color:var(--tinta); }
    .logo-top{ text-align:center; margin:4px 0 16px; }
    .logo-top img{ width:56px; height:56px; border-radius:50%; }
    .cartfab{ position:fixed; top:14px; right:14px; z-index:20; display:flex; align-items:center; gap:7px;
      background:var(--birutua); color:#fff; font-size:17px; line-height:1; padding:10px 13px;
      border-radius:999px; box-shadow:0 4px 14px rgba(15,42,55,.25); text-decoration:none; transition:transform .15s var(--ease); }
    .cartfab:active{ transform:scale(.94); }
    .cartfab .fabn{ background:var(--kuning); color:var(--birutua); font-size:12px; font-weight:800; min-width:19px;
      height:19px; border-radius:10px; display:flex; align-items:center; justify-content:center; padding:0 5px; }

    .hero{ text-align:center; max-width:640px; margin:0 auto 22px; }
    .hero h1{ font-size:28px; line-height:1.22; font-weight:800; color:var(--tinta); }
    .hero .sub{ color:var(--isi); font-size:15px; line-height:1.65; margin-top:12px; font-weight:500; }
    .hero .sub b{ font-weight:800; color:var(--tinta); }

    .cards{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .card{ background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; display:flex; flex-direction:column;
      transition:transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease); }
    .card:hover{ transform:translateY(-3px); box-shadow:0 10px 24px rgba(31,115,150,.14); border-color:var(--garisk); }
    .card:active{ transform:scale(.985); }
    .body{ padding:14px 15px 16px; display:flex; flex-direction:column; flex:1; }
    .body h3{ font-size:18px; font-weight:800; color:var(--tinta); }
    .origin{ color:var(--redup); font-size:11px; font-weight:600; letter-spacing:.04em; margin-top:2px; }
    .dots{ display:flex; gap:5px; }
    .dots b{ width:12px; height:12px; border-radius:50%; border:1.5px solid var(--garisk); background:var(--kabut); }
    .dots b.on{ background:var(--biru); border-color:var(--biru); }
    .blurb{ color:var(--isi); font-size:13px; line-height:1.6; flex:1; font-weight:500; }
    .price{ display:flex; align-items:baseline; gap:8px; margin:13px 0 4px; flex-wrap:wrap; }
    .price .mp{ color:var(--redup); font-size:13px; text-decoration:line-through; font-weight:500; }
    .price .now{ color:var(--biru); font-size:23px; font-weight:800; }
    .price .per{ color:var(--redup); font-size:12px; font-weight:600; }
    .cups{ color:var(--redup); font-size:12px; font-weight:500; margin-bottom:12px; }
    .buy{ margin-top:auto; display:flex; align-items:center; justify-content:center; height:46px; padding:0 12px; text-align:center; border-radius:var(--r-tombol);
      font-size:14px; font-weight:700; background:#fff; color:var(--birutua); border:1.5px solid var(--birutua); transition:transform .15s var(--ease); }
    .card.utama .buy{ background:var(--kuning); border-color:var(--kuning); }
    .card:active .buy{ transform:scale(.97); }

    .proof{ text-align:center; margin:40px 0 0; }
    .proof h2, .ragu h2{ font-size:22px; font-weight:800; color:var(--tinta); }
    .psub{ color:var(--isi); font-size:14px; margin:8px auto 18px; max-width:520px; font-weight:500; }
    .testi-track{ display:flex; align-items:flex-start; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; padding-bottom:12px; scrollbar-width:thin; }
    .testi-card{ flex:0 0 auto; width:300px; scroll-snap-align:start; background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; }
    .testi-card img{ width:100%; display:block; }

    .ragu{ text-align:center; background:var(--kabut); border-radius:16px; padding:26px 22px; margin:40px 0 0; }
    .ragu p{ color:var(--isi); font-size:15px; line-height:1.7; max-width:580px; margin:12px auto 0; font-weight:500; }
    .ragu p b{ color:var(--tinta); font-weight:800; }

    .imgs{ position:relative; background:var(--kabut); }
    .imgtrack{ display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
    .imgtrack::-webkit-scrollbar{ display:none; }
    .imgslide{ flex:0 0 100%; scroll-snap-align:start; aspect-ratio:4/3; }
    .imgslide img{ width:100%; height:100%; object-fit:cover; display:block; }
    .idots{ position:absolute; bottom:8px; left:0; right:0; display:flex; gap:6px; justify-content:center; }
    .idots b{ width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,.6); box-shadow:0 0 2px rgba(0,0,0,.3); transition:background .2s var(--ease); }
    .idots b.on{ background:#fff; }
    .lvl{ align-self:flex-start; font-size:12px; font-weight:800; letter-spacing:.05em; padding:5px 11px; border-radius:7px; margin-bottom:9px; }
    .lvl.l3{ background:var(--kuning); color:var(--birutua); }
    .lvl.l2{ background:var(--birutua); color:#fff; }
    .lvl.l1{ background:var(--kabut); color:var(--biru); }
    .meter{ display:flex; align-items:center; gap:9px; margin:10px 0; }
    .meter span{ font-size:11px; font-weight:700; color:var(--redup); }

    @media(max-width:720px){
      .cards{ grid-template-columns:1fr; gap:14px; }
      .card{ flex-direction:row; align-items:stretch; }
      .imgs{ width:140px; flex-shrink:0; }
      .hero h1{ font-size:24px; }
      .testi-card{ width:250px; }
    }
    @media(max-width:440px){
      .card{ flex-direction:column; }
      .imgs{ width:100%; }
    }
  </style>

  <script>
    // Tombol keranjang cuma muncul kalau memang sudah ada isinya, biar halaman
    // iklan tetap bersih buat pengunjung baru.
    function syncFab(){
      try{
        const n=JSON.parse(localStorage.getItem('kb_cart')||'[]').reduce(function(s,i){ return s+i.qty; },0);
        const fab=document.getElementById('cartFab');
        if(!fab) return;
        document.getElementById('cartFabN').textContent=n;
        fab.style.display = n>0 ? 'flex' : 'none';
      }catch(e){}
    }
    syncFab();
    window.addEventListener('storage',syncFab);
    window.addEventListener('pageshow',syncFab);

    document.querySelectorAll('.imgs').forEach(function(box){
      const track=box.querySelector('.imgtrack');
      const dots=box.querySelectorAll('.idots b');
      track.addEventListener('scroll',function(){
        const i=Math.round(track.scrollLeft/track.clientWidth);
        dots.forEach(function(d,k){ d.classList.toggle('on', k===i); });
      },{passive:true});
    });
  </script>
</Base>
