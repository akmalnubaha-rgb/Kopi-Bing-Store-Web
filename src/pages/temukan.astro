---
import Base from '../layouts/Base.astro';
import { products } from '../data/products.js';
const SD = {
"robusta-sidikalang":"sanger, tubruk, Vietnam drip",
"robusta-java-perfecto":"Vietnam drip, sanger",
"robusta-lampung":"tubruk, kopi susu",
"robusta-temanggung":"kopi susu, tubruk",
"robusta-gayo":"tubruk, kopi susu harian",
"robusta-toraja":"tubruk",
"robusta-lanang":"kopi susu strong, sanger",
"arabika-aceh-gayo":"V60, tubruk",
"arabika-gayo-wine":"V60, manual - wine/fermentasi",
"arabika-ijen-geisha":"V60, Japanese iced",
"arabika-yellow-caturra":"V60, Japanese iced",
"arabika-gn-halu":"V60, tubruk - ramah lambung",
"arabika-gn-puntang":"V60, Japanese iced",
"arabika-papua-wamena":"tubruk, V60 - ramah lambung",
"arabika-toraja":"tubruk, V60",
"espresso-bold-blend":"espresso, kopi susu",
"arabusta-blend-50-50":"kopi susu, americano",
"premium-blend-a70":"americano, tubruk"
};
const P = products.map(p=>({s:p.slug,n:p.name,c:p.cat,p:p.prices[100],b:!!p.bestseller,sd:SD[p.slug]||""}));
const MAP = {
"robusta|strong":["robusta-sidikalang","robusta-java-perfecto","robusta-lampung"],
"robusta|sedang":["robusta-temanggung","robusta-gayo","robusta-lampung"],
"arabika|cerah":["arabika-ijen-geisha","arabika-yellow-caturra","arabika-gn-puntang"],
"arabika|fermentasi":["arabika-gayo-wine","arabika-ijen-geisha","arabika-yellow-caturra"],
"arabika|lembut":["arabika-gn-halu","arabika-papua-wamena","arabika-aceh-gayo"],
"blend|pahit":["espresso-bold-blend","arabusta-blend-50-50","premium-blend-a70"],
"blend|asam":["premium-blend-a70","arabusta-blend-50-50","espresso-bold-blend"]
};
---
<Base title="Temuin kopimu — Toko Kopi Bing" description="Jawab 2 pertanyaan singkat, kami bantu pilihkan kopi yang paling cocok sama seleramu." naked={true}>
  <div id="kbapp" class="kbk"></div>
  <script define:vars={{ P, MAP }}>
    var TASTE={robusta:"pahit",arabika:"asem",blend:"seimbang"};
    var ILU='/img/ds2/ilustrasi-kuis.svg';
    var app=document.getElementById('kbapp');var q={};var depth=0;var busy=false;
    // Script ini inline (define:vars memaksa is:inline), jadi tidak bisa import trackMeta.
    // Polanya sama seperti halaman produk: event dititipkan ke antrean, dikuras modul di bawah.
    function kbTrack(name,params){
      var id=name.toLowerCase()+'_'+Date.now()+'_'+Math.random().toString(36).slice(2);
      (window.__kbq=window.__kbq||[]).push([name,params,id]);
      if(window.kbDrainTrack) window.kbDrainTrack();
    }
    var TESTI=[];for(var _i=1;_i<=15;_i++)TESTI.push('/img/testi/'+_i+'.webp');
    function get(sl){for(var i=0;i<P.length;i++)if(P[i].s===sl)return P[i];}
    function rp(x){return "Rp "+Number(x).toLocaleString('id-ID');}
    function cap(t){return t.charAt(0).toUpperCase()+t.slice(1);}
    function tile(pr,d){
      return '<a class="kbtile kbin" style="--d:'+d+'ms" href="/produk/'+pr.s+'">'
      +'<div class="kbfoto"><img src="/img/'+pr.s+'.webp" alt="'+pr.n+'" loading="lazy" /></div>'
      +'<div class="kbtk"><div class="kbtn">'+pr.n+'</div>'
      +'<div class="kbts">'+cap(pr.c)+(pr.sd?' &middot; '+pr.sd:'')+'</div>'
      +'<div class="kbtp">'+rp(pr.p)+' <small>/100 gr</small></div></div></a>';}
    function ilu(h){return '<div class="kbilu" style="height:'+h+'px"><img src="'+ILU+'" alt="" /></div>';}
    function viewGate(){
      app.innerHTML='<div class="kbv">'+ilu(150)
      +'<div class="kbisi" style="text-align:center">'
      +'<div class="kbkecil">KOPI GILING SELURUH INDONESIA</div>'
      +'<h1 class="kbh1">Kami bantu pilih kopi seleramu!</h1>'
      +'<p class="kbp">Jawab 2 pertanyaan singkat, nanti kami pilihkan kopi yang paling cocok.</p>'
      +'<button type="button" id="g1" class="btn btn-kuning kbfull">Bantu pilihkan (30 detik)</button>'
      +'<a id="g2" href="/" class="btn btn-garis kbfull" style="margin-top:10px">Lihat semua katalog</a>'
      +'<div class="kbjam"><div><i>&#10003;</i> Bisa request gilingan</div><div><i>&#10003;</i> Aman, live setiap hari di TikTok</div><div><i>&#10003;</i> Pembayaran diproses aman</div></div>'
      +'<div class="kbtesti"><div class="kbjd">Kata pelanggan Kopi Bing</div>'
      +'<div class="kbtrack">'+TESTI.map(function(src){return '<div class="kbtc"><img src="'+src+'" loading="lazy" alt="Testimoni pelanggan Kopi Bing" /></div>';}).join('')+'</div></div>'
      +'</div></div>';
      document.getElementById('g1').onclick=function(){q={};kbTrack('KuisMulai',{asal:'gate'});go('q1');};}
    var optN=0;
    function opt(txt,sub,val){return '<button type="button" class="kbopt kbin" style="--d:'+(optN++*60)+'ms" data-v="'+val+'"><span class="kbot"><b>'+txt+'</b><span>'+sub+'</span></span><i>&#8250;</i></button>';}
    function atas(step){return '<div class="kbatas"><button type="button" class="kbback" id="kbback">&larr; Kembali</button>'
      +'<div class="kbprog">'+[1,2].map(function(i){return '<span class="'+(i<=step?'on':'')+'"></span>';}).join('')+'</div>'
      +'<div class="kbkecil" style="margin:0">Pertanyaan '+step+' dari 2</div></div>';}
    function frame(step,qt,body){
      app.innerHTML='<div class="kbv">'+(step===1?ilu(130):'')+atas(step)
      +'<div class="kbisi"><h1 class="kbh2">'+qt+'</h1>'+body
      +'<div class="kbcat"><a href="/">Lihat katalog</a></div></div></div>';
      document.getElementById('kbback').onclick=function(){if(busy)return;if(depth>0)history.back();else if(step===2){go('q1');}else{location.href='/';}};}
    function pilih(el,fn){
      if(busy)return;busy=true;el.classList.add('kbpop');
      setTimeout(function(){busy=false;fn();},300);}
    function viewQ1(){
      optN=0;
      var body=opt("Pahit &amp; nendang","enak buat tubruk, Vietnam drip, sanger - bikin melek","robusta")
      +opt("Asam &amp; fruity","diseduh manual: V60 / Japanese iced","arabika")
      +opt("Seimbang, pahit ketemu asam","espresso based - kopi susu / americano, aman harian","blend");
      frame(1,"Kamu suka kopi dengan rasa yang gimana?",body);
      Array.prototype.forEach.call(document.querySelectorAll('.kbopt'),function(el){el.onclick=function(){pilih(el,function(){q.rasa=el.dataset.v;kbTrack('KuisJawab1',{rasa:q.rasa});go('q2');});};});}
    function viewQ2(){var qt,body;optN=0;
      if(q.rasa==="robusta"){qt="Seberapa pahit yang kamu mau?";body=opt("Strong, bener-bener nendang","sanger, Vietnam drip, kopi susu strong - bikin melek","strong")+opt("Pahit sedang, buat harian","enak buat tubruk &amp; kopi susu harian","sedang");}
      else if(q.rasa==="arabika"){qt="Asamnya kamu mau kayak gimana?";body=opt("Cerah &amp; fruity (asam tinggi)","paling enak Japanese iced / cold brew","cerah")+opt("Fermentasi / wine, unik","rasa beda, wine-like","fermentasi")+opt("Lembut &amp; ringan","ramah di lambung, pas V60 &amp; tubruk","lembut");}
      else{qt="Condongnya ke mana?";body=opt("Lebih ke pahit","buat kopi susu strong / espresso","pahit")+opt("Lebih ke asam","americano / diseduh hitam, ringan","asam");}
      frame(2,qt,body);
      Array.prototype.forEach.call(document.querySelectorAll('.kbopt'),function(el){el.onclick=function(){pilih(el,function(){q.lvl=el.dataset.v;go('result');});};});}
    var LBL={strong:"Strong",sedang:"Sedang",cerah:"Cerah",fermentasi:"Fermentasi",lembut:"Lembut",pahit:"Lebih pahit",asam:"Lebih asam"};
    var RL={robusta:"Pahit",arabika:"Asam",blend:"Seimbang"};
    function viewResult(){
      var slugs=MAP[q.rasa+"|"+q.lvl]; if(!slugs){q={};render('q1');return;}
      var main=get(slugs[0]),alt=[get(slugs[1]),get(slugs[2])];
      app.innerHTML='<div class="kbv"><div class="kbisi" style="padding-top:22px">'
      +'<div class="kbjudul kbin" style="--d:0ms"><div class="kbkecil">REKOMENDASI BUAT KAMU</div><h1 class="kbh2" style="text-align:center;margin:2px 0">Ini kopi yang paling pas</h1>'
      +'<div class="kbjalur">'+(RL[q.rasa]||'')+' &middot; '+(LBL[q.lvl]||'')+'</div></div>'
      +'<a href="/produk/'+main.s+'" class="kbutama kbin" style="--d:90ms">'
      +'<div class="kbfoto kbbesar"><img src="/img/'+main.s+'.webp" alt="'+main.n+'" /><div class="kbtag"><span class="y">PILIHAN UTAMA</span>'+(main.b?'<span class="g">TERLARIS</span>':'')+'</div></div>'
      +'<div class="kbket"><div class="kbnm">'+main.n+'</div>'
      +'<div class="kbsub">'+cap(main.c)+' ('+TASTE[main.c]+')'+(main.sd?' &middot; Paling enak: '+main.sd:'')+'</div>'
      +'<div class="kbhb"><span class="kbhg">'+rp(main.p)+' <small>/100 gr</small></span><span class="btn btn-kuning kbpesan">Pesan sekarang</span></div></div></a>'
      +'<div class="kbmirip kbin" style="--d:180ms">Atau yang mirip:</div>'
      +'<div class="kbalt">'+alt.map(function(p,i){return tile(p,260+i*90);}).join('')+'</div>'
      +'<button type="button" id="kbretry" class="kbulang kbin" style="--d:420ms">&#8634; Ulangi kuis</button>'
      +'<div class="kbtombol kbin" style="--d:480ms"><a href="/" class="btn btn-gelap">Lihat semua kopi</a><a href="/" class="btn btn-garis">&larr; Ke beranda</a></div>'
      +'<div class="kbjamin kbin" style="--d:540ms">Digiling saat kamu pesan &middot; Live tiap hari di TikTok &middot; Pembayaran aman</div>'
      +'</div></div>';
      document.getElementById('kbretry').onclick=function(){q={};kbTrack('KuisMulai',{asal:'ulangi'});go('q1');};
      kbTrack('KuisSelesai',{rasa:q.rasa,level:q.lvl,content_ids:slugs,content_type:'product',rekomendasi:main.s});
      // Klik rekomendasi: yang mana yang dipilih, sebelum pindah ke halaman produk.
      Array.prototype.forEach.call(app.querySelectorAll('a[href^="/produk/"]'),function(a){
        a.addEventListener('click',function(){
          var slug=a.getAttribute('href').split('/').pop();
          kbTrack('KuisPilihProduk',{content_ids:[slug],content_type:'product',posisi:slug===main.s?'utama':'alternatif'});
        });
      });}
    var VIEWS={gate:viewGate,q1:viewQ1,q2:viewQ2,result:viewResult};
    function render(v,arah){(VIEWS[v]||viewGate)();var e=app.firstElementChild;if(e){e.classList.add(arah==='mundur'?'kbmasuk-k':'kbmasuk');}window.scrollTo(0,0);}
    function go(v){
      history.pushState({view:v,q:JSON.parse(JSON.stringify(q))},'',location.pathname+location.search);depth++;
      var old=app.firstElementChild;
      if(old&&old.classList.contains('kbv')){busy=true;old.classList.add('kbkeluar');setTimeout(function(){busy=false;render(v,'maju');},200);}
      else render(v,'maju');}
    window.addEventListener('popstate',function(e){if(e.state&&e.state.view){q=e.state.q||{};depth=Math.max(0,depth-1);render(e.state.view,'mundur');}});
    var params=new URLSearchParams(location.search);
    var startView=params.get('mulai')?'q1':'gate';
    history.replaceState({view:startView,q:{}},'',location.pathname+location.search);
    render(startView);
    // ?mulai=1 melompati halaman pembuka, jadi kuisnya langsung mulai di sini.
    if(startView==='q1') kbTrack('KuisMulai',{asal:'langsung'});
  </script>

  <style is:global>
    .kbk{ max-width:640px; margin:0 auto; color:var(--tinta); overflow-x:hidden; min-height:100vh; }
    .kbilu{ background:var(--kabut); overflow:hidden; }
    .kbilu img{ width:100%; height:100%; object-fit:cover; display:block; }
    .kbisi{ padding:18px 16px 28px; }
    .kbkecil{ font-size:11px; font-weight:700; letter-spacing:.06em; color:var(--redup); margin-bottom:10px; }
    .kbh1{ font-size:26px; font-weight:800; line-height:1.25; color:var(--tinta); margin:0 auto 12px; max-width:420px; }
    .kbh2{ font-size:22px; font-weight:800; line-height:1.28; color:var(--tinta); margin:4px 0 14px; }
    .kbp{ font-size:14px; line-height:1.55; color:var(--isi); margin:0 auto 22px; max-width:360px; }
    .kbfull{ display:flex; width:100%; max-width:340px; margin-left:auto; margin-right:auto; }
    .kbjam{ max-width:340px; margin:24px auto 0; text-align:left; display:flex; flex-direction:column; gap:10px; font-size:13px; font-weight:500; color:var(--isi); }
    .kbjam i{ font-style:normal; color:var(--hijau); font-weight:800; margin-right:4px; }
    .kbtesti{ margin-top:30px; text-align:left; }
    .kbjd{ font-size:14px; font-weight:800; color:var(--tinta); margin-bottom:10px; }
    .kbtrack{ display:flex; gap:10px; overflow-x:auto; padding-bottom:8px; scroll-snap-type:x mandatory; }
    .kbtc{ flex:0 0 auto; width:260px; scroll-snap-align:start; background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; }
    .kbtc img{ width:100%; display:block; }

    .kbatas{ display:flex; flex-direction:column; align-items:flex-start; gap:10px; padding:16px 16px 0; }
    .kbback{ background:none; border:0; padding:0; font:inherit; font-size:13px; font-weight:700; color:var(--biru); cursor:pointer; }
    .kbprog{ display:flex; gap:6px; width:100%; }
    .kbprog span{ flex:1; height:5px; border-radius:3px; background:var(--kabut); transition:background .3s var(--ease); }
    .kbprog span.on{ background:var(--biru); }
    .kbopt{ display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; text-align:left; font:inherit;
      background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); padding:14px; margin-bottom:10px; cursor:pointer;
      transition:border-color .2s var(--ease), background .2s var(--ease), transform .2s var(--ease); }
    .kbopt:hover{ border-color:var(--biru); background:var(--kabut); }
    .kbot b{ display:block; font-size:15px; font-weight:800; color:var(--tinta); }
    .kbot span{ display:block; font-size:12px; font-weight:500; color:var(--isi); line-height:1.4; margin-top:3px; }
    .kbopt i{ font-style:normal; font-size:22px; font-weight:700; color:var(--garisk); line-height:1; }
    .kbopt:hover i{ color:var(--biru); }
    .kbopt.kbpop{ border:2px solid var(--biru); background:var(--kabut); padding:13px; animation:kbpop .3s var(--ease-pantul); }
    @keyframes kbpop{ 0%{transform:scale(1)} 40%{transform:scale(.95)} 75%{transform:scale(1.03)} 100%{transform:scale(1)} }
    .kbcat{ text-align:right; margin-top:6px; }
    .kbcat a{ font-size:13px; font-weight:600; color:var(--biru); text-decoration:underline; }

    .kbjudul{ text-align:center; margin-bottom:14px; }
    .kbjudul .kbkecil{ margin-bottom:4px; }
    .kbjalur{ font-size:12px; font-weight:700; color:var(--biru); }
    .kbutama{ display:block; background:#fff; border:2px solid var(--biru); border-radius:16px; overflow:hidden; color:inherit; text-decoration:none; }
    .kbfoto{ background:var(--kabut); overflow:hidden; }
    .kbfoto{ background:#F4F7F4; }
    .kbfoto img{ width:100%; height:100%; object-fit:contain; display:block; }
    .kbbesar{ position:relative; aspect-ratio:4/3; }
    .kbtag{ position:absolute; top:12px; left:12px; display:flex; gap:4px; }
    .kbtag span{ font-size:10px; font-weight:800; letter-spacing:.04em; padding:5px 8px; border-radius:6px; }
    .kbtag .y{ background:var(--kuning); color:var(--birutua); }
    .kbtag .g{ background:var(--birutua); color:#fff; }
    .kbket{ padding:14px 16px 16px; }
    .kbnm{ font-size:19px; font-weight:800; color:var(--tinta); }
    .kbsub{ font-size:13px; font-weight:500; color:var(--isi); margin-top:5px; line-height:1.4; }
    .kbhb{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:12px; }
    .kbhg{ font-size:18px; font-weight:800; color:var(--biru); }
    .kbhg small, .kbtp small{ font-size:12px; font-weight:600; color:var(--redup); }
    .kbpesan{ padding:0 16px; flex-shrink:0; }
    .kbmirip{ font-size:13px; font-weight:700; color:var(--isi); margin:16px 0 9px; }
    .kbalt{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .kbtile{ background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; color:inherit; text-decoration:none; display:flex; flex-direction:column; }
    .kbtile .kbfoto{ aspect-ratio:3/2; }
    .kbtk{ padding:10px 12px 12px; }
    .kbtn{ font-size:14px; font-weight:800; color:var(--tinta); line-height:1.25; }
    .kbts{ font-size:11px; font-weight:500; color:var(--redup); margin:3px 0 6px; line-height:1.35; }
    .kbtp{ font-size:13px; font-weight:800; color:var(--biru); }
    .kbulang{ display:block; margin:16px auto 0; background:none; border:0; font:inherit; font-size:13px; font-weight:700; color:var(--biru); cursor:pointer; padding:6px 10px; }
    .kbtombol{ display:flex; gap:10px; margin-top:10px; }
    .kbtombol .btn{ flex:1; min-width:0; }
    .kbjamin{ margin-top:14px; background:var(--kabut); border-radius:12px; padding:12px 14px; font-size:12px; font-weight:600; line-height:1.5; color:var(--birutua); text-align:center; }

    /* pindah layar: keluar ke kiri, masuk dari kanan (mundur: kebalikannya) */
    .kbmasuk{ animation:kbmasuk .32s var(--ease) both; }
    .kbmasuk-k{ animation:kbmasukk .32s var(--ease) both; }
    .kbkeluar{ animation:kbkeluar .2s ease-in both; }
    @keyframes kbmasuk{ from{opacity:0;transform:translateX(28px)} to{opacity:1;transform:none} }
    @keyframes kbmasukk{ from{opacity:0;transform:translateX(-28px)} to{opacity:1;transform:none} }
    @keyframes kbkeluar{ from{opacity:1;transform:none} to{opacity:0;transform:translateX(-28px)} }
    /* kartu muncul bergantian */
    .kbin{ animation:kbin .45s var(--ease) both; animation-delay:var(--d,0ms); }
    @keyframes kbin{ from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:none} }
    @media(prefers-reduced-motion:reduce){ .kbmasuk,.kbmasuk-k,.kbkeluar,.kbin,.kbopt.kbpop{ animation:none; } }
    @media(min-width:640px){ .kbk{ padding-top:10px; } .kbilu{ border-radius:0 0 var(--r-kartu) var(--r-kartu); } }
  </style>

  <!-- Penguras antrean, pola sama dengan halaman produk. Script ini modul (tanpa
       define:vars) supaya bisa mengimpor trackMeta: pixel browser + relay CAPI
       dengan event_id yang sama. -->
  <script>
    import { trackMeta } from '../data/scalev.js';
    window.kbDrainTrack=function(){
      const q=window.__kbq||[];
      while(q.length){
        const e=q.shift();
        try{ trackMeta(e[0], e[1], e[2], {}); }catch(err){}
      }
    };
    window.kbDrainTrack();
  </script>
</Base>
