---
import Base from '../layouts/Base.astro';
import { products } from '../data/products.js';
const SD = {
"robusta-sidikalang":"sanger, tubruk, Vietnam drip",
"robusta-java-perfecto":"Vietnam drip, sanger",
"robusta-lampung":"tubruk, kopi susu",
"robusta-temanggung":"kopi susu, tubruk",
"robusta-gayo":"tubruk, kopi susu harian",
"robusta-toraja":"tubruk",
"robusta-lanang":"kopi susu strong, sanger",
"arabika-aceh-gayo":"V60, tubruk",
"arabika-gayo-wine":"V60, manual - wine/fermentasi",
"arabika-ijen-geisha":"V60, Japanese iced",
"arabika-java-ijen":"V60, tubruk - ramah lambung",
"arabika-yellow-caturra":"V60, Japanese iced",
"arabika-gn-halu":"V60, tubruk - ramah lambung",
"arabika-gn-puntang":"V60, Japanese iced",
"arabika-papua-wamena":"tubruk, V60 - ramah lambung",
"arabika-toraja":"tubruk, V60",
"espresso-bold-blend":"espresso, kopi susu",
"arabusta-blend-50-50":"kopi susu, americano",
"premium-blend-a70":"americano, tubruk"
};
const P = products.map(p=>({s:p.slug,n:p.name,c:p.cat,p:p.prices[100],b:!!p.bestseller,sd:SD[p.slug]||""}));
const MAP = {
"robusta|strong":["robusta-sidikalang","robusta-java-perfecto","robusta-lampung"],
"robusta|sedang":["robusta-temanggung","robusta-gayo","robusta-lampung"],
"arabika|cerah":["arabika-ijen-geisha","arabika-yellow-caturra","arabika-gn-puntang"],
"arabika|fermentasi":["arabika-gayo-wine","arabika-ijen-geisha","arabika-yellow-caturra"],
"arabika|lembut":["arabika-gn-halu","arabika-java-ijen","arabika-aceh-gayo"],
"blend|pahit":["espresso-bold-blend","arabusta-blend-50-50","premium-blend-a70"],
"blend|asam":["premium-blend-a70","arabusta-blend-50-50","espresso-bold-blend"]
};
---
<Base title="Temuin kopimu - Toko Kopi Bing" naked={true}>
  <div style="text-align:center;padding:14px 0 4px"><img src="/img/logo.png" alt="Kopi Bing" style="width:52px;height:52px;border-radius:50%" /></div>
  <div id="kbapp" class="wrap" style="max-width:640px;color:var(--ink)"></div>
  <script define:vars={{ P, MAP }}>
    var TASTE={robusta:"pahit",arabika:"asem",blend:"seimbang"};
    var BR="#804C2A",BRD="#5A3419",GRN="#3E8E41",CREAM="#F3E7CE",MUT="#8a7a68";
    var app=document.getElementById('kbapp');var q={};
    var TESTI=[];for(var _i=1;_i<=15;_i++)TESTI.push('/img/testi/'+_i+'.webp');
    function get(sl){for(var i=0;i<P.length;i++)if(P[i].s===sl)return P[i];}
    function rp(x){return "Rp"+Number(x).toLocaleString('id-ID');}
    function pic(pr){return '<div style="aspect-ratio:4/3;background:'+CREAM+';overflow:hidden"><img src="/img/'+pr.s+'.webp" alt="'+pr.n+'" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" /></div>';}
    function tile(pr){
      return '<a href="/produk/'+pr.s+'" style="background:#fff;border:0.5px solid #E6D6B8;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;text-decoration:none;color:inherit">'
      +pic(pr)
      +'<div style="padding:9px 10px 11px;display:flex;flex-direction:column;flex:1">'
      +'<div style="font-size:12px;font-weight:500;line-height:1.25">'+pr.n+'</div>'
      +'<div style="font-size:10px;color:'+MUT+';margin:3px 0 6px">Seduh: '+pr.sd+'</div>'
      +'<div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between"><span style="font-size:12px;color:'+BR+';font-weight:600">mulai '+rp(pr.p)+'</span><span style="font-size:11px;background:'+GRN+';color:#fff;padding:6px 10px;border-radius:7px">Pesan</span></div>'
      +'</div></a>';}
    function viewGate(){
      app.innerHTML='<div style="padding:26px 14px 34px;text-align:center">'
      +'<div style="font-size:11px;letter-spacing:1px;color:'+MUT+';margin-bottom:14px">KOPI GILING SELURUH INDONESIA</div>'
      +'<div style="font-size:24px;font-weight:600;color:'+BRD+';line-height:1.3;max-width:420px;margin:0 auto 24px">Kami bantu pilih kopi seleramu!</div>'
      +'<div id="g1" style="background:'+GRN+';color:#fff;font-weight:500;font-size:16px;padding:15px;border-radius:11px;cursor:pointer;max-width:340px;margin:0 auto">Bantu pilihkan (30 detik)</div>'
      +'<a id="g2" href="/" style="display:block;border:1px solid #D8C6A8;color:'+BR+';font-weight:500;font-size:15px;padding:14px;border-radius:11px;text-decoration:none;max-width:340px;margin:12px auto 0">Lihat semua katalog</a>'
      +'<div style="max-width:340px;margin:22px auto 0;text-align:left;display:flex;flex-direction:column;gap:9px">'
      +'<div style="font-size:13px;color:#5A4636"><span style="color:'+GRN+'">&#10003;</span> Bisa request gilingan</div>'
      +'<div style="font-size:13px;color:#5A4636"><span style="color:'+GRN+'">&#10003;</span> Aman, live setiap hari di TikTok</div>'
      +'<div style="font-size:13px;color:#5A4636"><span style="color:'+GRN+'">&#10003;</span> Pembayaran diproses aman</div>'
      +'</div>'
      +'<div style="margin:28px 0 2px"><div style="font-size:13px;font-weight:600;color:'+BRD+';text-align:left;margin:0 0 10px">Kata pelanggan Kopi Bing</div>'
      +'<div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;scroll-snap-type:x mandatory">'+TESTI.map(function(src){return '<div style="flex:0 0 auto;width:260px;scroll-snap-align:start;background:#fff;border:0.5px solid #E6D6B8;border-radius:10px;overflow:hidden"><img src="'+src+'" loading="lazy" style="width:100%;display:block" /></div>';}).join('')+'</div></div>'
      +'</div>';
      document.getElementById('g1').onclick=function(){q={};go('q1');};}
    function opt(txt,sub,val){return '<div class="kbopt" data-v="'+val+'" style="border:1px solid #E6D6B8;background:#fff;border-radius:11px;padding:14px 16px;cursor:pointer;margin-bottom:10px;text-align:left"><div style="font-size:15px;font-weight:500;color:'+BRD+'">'+txt+'</div><div style="font-size:12px;color:'+GRN+';margin-top:3px">'+sub+'</div></div>';}
    function prog(step){return '<div style="display:flex;gap:6px;margin-bottom:18px">'+[1,2].map(function(i){return '<div style="flex:1;height:5px;border-radius:3px;background:'+(i<=step?BR:'#E6D6B8')+'"></div>';}).join('')+'</div>';}
    function frame(step,qt,body){app.innerHTML='<div style="padding:20px 14px 26px">'+prog(step)
      +'<div style="font-size:12px;color:'+MUT+';margin-bottom:8px">Pertanyaan '+step+' dari 2</div>'
      +'<div style="font-size:19px;font-weight:600;color:'+BRD+';margin-bottom:16px;line-height:1.3">'+qt+'</div>'+body
      +'<div style="text-align:right;margin-top:6px"><a href="/" style="font-size:13px;color:'+BR+';text-decoration:underline">Lihat katalog</a></div></div>';
      Array.prototype.forEach.call(document.querySelectorAll('.kbopt'),function(el){el.onmouseover=function(){el.style.borderColor=BR;el.style.background=CREAM;};el.onmouseout=function(){el.style.borderColor="#E6D6B8";el.style.background="#fff";};});}
    function viewQ1(){
      var body=opt("Pahit &amp; nendang","enak buat tubruk, Vietnam drip, sanger - bikin melek","robusta")
      +opt("Asam &amp; fruity","diseduh manual: V60 / Japanese iced","arabika")
      +opt("Seimbang, pahit ketemu asam","espresso based - kopi susu / americano, aman harian","blend");
      frame(1,"Kamu suka kopi dengan rasa yang gimana?",body);
      Array.prototype.forEach.call(document.querySelectorAll('.kbopt'),function(el){el.onclick=function(){q.rasa=el.dataset.v;go('q2');};});}
    function viewQ2(){var qt,body;
      if(q.rasa==="robusta"){qt="Seberapa pahit yang kamu mau?";body=opt("Strong, bener-bener nendang","sanger, Vietnam drip, kopi susu strong - bikin melek","strong")+opt("Pahit sedang, buat harian","enak buat tubruk &amp; kopi susu harian","sedang");}
      else if(q.rasa==="arabika"){qt="Asamnya kamu mau kayak gimana?";body=opt("Cerah &amp; fruity (asam tinggi)","paling enak Japanese iced / cold brew","cerah")+opt("Fermentasi / wine, unik","rasa beda, wine-like","fermentasi")+opt("Lembut &amp; ringan","ramah di lambung, pas V60 &amp; tubruk","lembut");}
      else{qt="Condongnya ke mana?";body=opt("Lebih ke pahit","buat kopi susu strong / espresso","pahit")+opt("Lebih ke asam","americano / diseduh hitam, ringan","asam");}
      frame(2,qt,body);
      Array.prototype.forEach.call(document.querySelectorAll('.kbopt'),function(el){el.onclick=function(){q.lvl=el.dataset.v;go('result');};});}
    function viewResult(){
      var slugs=MAP[q.rasa+"|"+q.lvl]; if(!slugs){q={};render('q1');return;}
      var main=get(slugs[0]),alt=[get(slugs[1]),get(slugs[2])];
      app.innerHTML='<div style="padding:22px 14px 30px">'
      +'<div style="font-size:12px;color:'+MUT+';text-align:center">REKOMENDASI BUAT KAMU</div>'
      +'<div style="font-size:20px;font-weight:600;color:'+BRD+';text-align:center;margin:4px 0 18px">Ini kopi yang paling pas</div>'
      +'<a href="/produk/'+main.s+'" style="background:#fff;border:2px solid '+GRN+';border-radius:14px;overflow:hidden;display:flex;text-decoration:none;color:inherit">'
      +'<div style="width:120px;flex-shrink:0;background:'+CREAM+'"><img src="/img/'+main.s+'.webp" alt="'+main.n+'" style="width:120px;height:100%;object-fit:cover;display:block" /></div>'
      +'<div style="padding:13px 15px;flex:1"><div style="font-size:11px;color:'+GRN+';font-weight:600">PILIHAN UTAMA</div>'
      +'<div style="font-size:17px;font-weight:600;color:'+BRD+';margin:2px 0">'+main.n+'</div>'
      +'<div style="font-size:10px;background:#F0E0C6;color:#804C2A;padding:2px 8px;border-radius:20px;display:inline-block">'+main.c+' ('+TASTE[main.c]+')</div>'
      +'<div style="font-size:12px;color:'+GRN+';margin:8px 0 2px">Paling enak: '+main.sd+'</div>'
      +'<div style="display:flex;align-items:center;justify-content:space-between;margin-top:8px"><span style="font-size:15px;font-weight:600;color:'+BR+'">mulai '+rp(main.p)+'</span><span style="font-size:13px;background:'+GRN+';color:#fff;padding:9px 16px;border-radius:8px">Pesan sekarang</span></div>'
      +'</div></a>'
      +'<div style="font-size:13px;color:'+MUT+';margin:16px 0 9px">Atau alternatif yang mirip:</div>'
      +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'+alt.map(function(p){return tile(p);}).join('')+'</div>'
      +'<div style="margin-top:16px;background:#FBF2DF;border-radius:10px;padding:12px 14px;font-size:12px;color:#5A4636;text-align:center">Digiling segar setiap pesanan - Live tiap hari di TikTok - Pembayaran aman</div>'
      +'<div style="display:flex;gap:10px;margin-top:14px"><span id="kbretry" style="flex:1;text-align:center;font-size:13px;border:1px solid #E6D6B8;border-radius:9px;padding:11px;cursor:pointer;color:'+BR+'">Ulangi kuis</span><a href="/" style="flex:1;text-align:center;font-size:13px;border:1px solid #E6D6B8;border-radius:9px;padding:11px;text-decoration:none;color:'+BR+'">Lihat semua kopi</a></div></div>';
      document.getElementById('kbretry').onclick=function(){q={};go('q1');};}
    var VIEWS={gate:viewGate,q1:viewQ1,q2:viewQ2,result:viewResult};
    function render(v){(VIEWS[v]||viewGate)();}
    function go(v){history.pushState({view:v,q:JSON.parse(JSON.stringify(q))},'',location.pathname+location.search);render(v);}
    window.addEventListener('popstate',function(e){if(e.state&&e.state.view){q=e.state.q||{};render(e.state.view);}});
    var params=new URLSearchParams(location.search);
    var startView=params.get('mulai')?'q1':'gate';
    history.replaceState({view:startView,q:{}},'',location.pathname+location.search);
    render(startView);
  </script>
</Base>
