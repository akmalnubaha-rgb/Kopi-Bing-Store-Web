---
import Base from '../layouts/Base.astro';
---
<Base title="Keranjang — Toko Kopi Bing" description="Isi keranjang belanjamu di Toko Kopi Bing." noindex={true}>
  <div class="wrap cartp">
    <a class="back" href="/#katalog">&#8592; Kembali ke beranda</a>
    <h1>Keranjang</h1>
    <div id="empty" class="empty" style="display:none">
      <p>Keranjang kamu masih kosong.</p>
      <a class="btn-buy" href="/#katalog">Mulai belanja</a>
    </div>
    <div id="list"></div>
    <div id="summary" class="summary" style="display:none">
      <div class="row"><span id="subLabel">Subtotal</span><span id="subtotal">Rp 0</span></div>
      <div class="row muted"><span>Ongkir</span><span>Dihitung saat checkout</span></div>
      <div class="row total"><span>Total</span><span id="total">Rp 0</span></div>
      <a class="btn-buy full" id="coBtn" href="/checkout">Lanjut ke checkout</a>
      <!-- Hanya tampil di mode corong: jalan balik ke halaman pilihan supaya pembeli
           bisa menambah kopi lain tanpa keluar dari corong. -->
      <a class="addmore" id="addMore" href="/" style="display:none">+ Tambah kopi lain</a>
    </div>

    <!-- Di luar kotak: satu-satunya pintu ke katalog lengkap saat mode corong,
         karena tautan navigasi di header disembunyikan. -->
    <a class="allcat" id="allCat" href="/#katalog" style="display:none">Lihat semua katalog Kopi Bing</a>
  </div>

  <style is:global>
    .cartp{ max-width:600px; margin:0 auto; padding:22px 16px 10px; }
    .cartp h1{ font-size:24px; font-weight:600; margin-bottom:18px; }
    .cartp .empty{ text-align:center; padding:44px 0; color:var(--muted); }
    .cartp .empty p{ margin-bottom:16px; }

    .cartp .item{ display:flex; gap:12px; background:#fff; border:0.5px solid #E6D6B8; border-radius:12px; padding:12px; margin-bottom:10px; }
    .cartp .ithumb{ width:78px; height:78px; border-radius:9px; object-fit:cover; flex-shrink:0; background:#F3E7CE; }
    .cartp .meta{ flex:1; min-width:0; display:flex; flex-direction:column; }
    .cartp .itop{ display:flex; justify-content:space-between; gap:8px; align-items:flex-start; }
    .cartp .iname{ font-size:14px; font-weight:500; color:var(--ink); line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .cartp .rm{ background:none; border:none; color:#C0A791; cursor:pointer; padding:0; flex-shrink:0; display:flex; }
    .cartp .rm:hover{ color:#A3502F; }
    .cartp .ivar{ align-self:flex-start; background:#F4ECDD; color:#7A5C3E; font-size:11px; padding:4px 10px; border-radius:6px; margin:7px 0 0; }
    .cartp .irow{ display:flex; align-items:center; justify-content:space-between; margin-top:auto; padding-top:10px; }
    .cartp .iprice{ color:var(--brown); font-size:15px; font-weight:600; }
    .cartp .qty{ display:flex; align-items:center; border:0.5px solid #D8C6A8; border-radius:8px; overflow:hidden; }
    .cartp .qty button{ width:28px; height:28px; background:#FBF6EC; border:none; color:var(--brown); font-size:15px; line-height:1; cursor:pointer; font-family:inherit; }
    .cartp .qty button:hover{ background:#F3E7CE; }
    .cartp .qty span{ min-width:34px; height:28px; display:flex; align-items:center; justify-content:center; font-size:13px; color:var(--ink); border-left:0.5px solid #D8C6A8; border-right:0.5px solid #D8C6A8; }

    .cartp .summary{ background:#fff; border:0.5px solid #E6D6B8; border-radius:14px; padding:20px; margin-top:12px; }
    .cartp .row{ display:flex; justify-content:space-between; font-size:14px; color:#6B4E37; margin-bottom:12px; }
    .cartp .row.muted span:last-child{ color:var(--muted); }
    .cartp .row.total{ font-size:17px; color:var(--ink); font-weight:600; padding-top:14px; margin-bottom:0; border-top:0.5px solid #E6D6B8; }
    .cartp .btn-buy.full{ display:block; width:100%; text-align:center; margin-top:18px; padding:14px; }
    .cartp .addmore{ display:block; text-align:center; color:var(--brown); font-size:13px; margin-top:14px; }
    .cartp .addmore:hover{ color:var(--teal-d); }
    .cartp .allcat{ display:block; text-align:center; color:var(--muted); font-size:13px; text-decoration:underline; margin-top:18px; }
    .cartp .allcat:hover{ color:var(--brown); }
  </style>

  <script>
    // Mode corong: pengunjung datang dari halaman iklan (mis. /pahit) lewat ikon
    // keranjang yang membawa ?lp=. Saringan sama seperti halaman lain.
    const LP=(function(v){ v=String(v||''); return /^[a-z0-9-]{1,64}$/i.test(v) ? v : ''; })(new URLSearchParams(location.search).get('lp'));
    if(LP){
      const back=document.querySelector('.cartp .back');
      if(back){ back.setAttribute('href','/'+LP); back.textContent='← Kembali ke pilihan'; }
      const co=document.getElementById('coBtn');
      if(co) co.setAttribute('href','/checkout?lp='+encodeURIComponent(LP));
      const add=document.getElementById('addMore');
      if(add){ add.setAttribute('href','/'+LP); add.style.display='block'; }
      const all=document.getElementById('allCat');
      if(all) all.style.display='block';
    }

    const fmt=(n)=>"Rp "+n.toLocaleString('id-ID');
    const trash='<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6M14 11v6"/></svg>';
    function load(){ return JSON.parse(localStorage.getItem('kb_cart')||'[]'); }
    function save(c){ localStorage.setItem('kb_cart',JSON.stringify(c)); const el=document.getElementById('cartCount'); if(el) el.textContent=c.reduce((s,i)=>s+i.qty,0); }
    function render(){
      const cart=load();
      const list=document.getElementById('list');
      const empty=document.getElementById('empty');
      const summary=document.getElementById('summary');
      if(!cart.length){ list.innerHTML=''; empty.style.display='block'; summary.style.display='none'; return; }
      empty.style.display='none'; summary.style.display='block';
      list.innerHTML=cart.map(function(it,idx){
        const w = it.g>=1000 ? '1kg' : it.g+'gr';
        return '<div class="item">'
          + '<img class="ithumb" src="/img/'+it.slug+'.webp" alt="'+it.name+'" />'
          + '<div class="meta">'
            + '<div class="itop"><div class="iname">'+it.name+'</div>'
            + '<button class="rm" data-a="rm" data-i="'+idx+'" aria-label="Hapus">'+trash+'</button></div>'
            + '<div class="ivar">'+w+' &middot; '+it.grind+'</div>'
            + '<div class="irow">'
              + '<div class="iprice">'+fmt(it.price*it.qty)+'</div>'
              + '<div class="qty"><button data-a="dec" data-i="'+idx+'" aria-label="Kurangi">&minus;</button><span>'+it.qty+'</span><button data-a="inc" data-i="'+idx+'" aria-label="Tambah">+</button></div>'
            + '</div>'
          + '</div>'
        + '</div>';
      }).join('');
      const sub=cart.reduce((s,i)=>s+i.price*i.qty,0);
      document.getElementById('subLabel').textContent='Subtotal ('+cart.reduce((s,i)=>s+i.qty,0)+' item)';
      document.getElementById('subtotal').textContent=fmt(sub);
      document.getElementById('total').textContent=fmt(sub);
    }
    document.getElementById('list').addEventListener('click',(e)=>{
      const b=e.target.closest('[data-a]'); if(!b) return;
      const cart=load(), i=+b.dataset.i;
      if(b.dataset.a==='inc') cart[i].qty++;
      else if(b.dataset.a==='dec'){ cart[i].qty--; if(cart[i].qty<1) cart.splice(i,1); }
      else if(b.dataset.a==='rm') cart.splice(i,1);
      save(cart); render();
    });
    render();
  </script>
</Base>
