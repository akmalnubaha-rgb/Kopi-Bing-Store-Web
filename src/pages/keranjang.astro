---
import Base from '../layouts/Base.astro';
import { products } from '../data/products.js';

// Cuma slug -> nama & harga, bukan seluruh katalog: yang dikirim ke browser tetap ringan.
const CATALOG = Object.fromEntries(products.map(p => [p.slug, { n: p.name, p: p.prices }]));
---
<script is:inline define:vars={{ CATALOG }}>window.KB_CATALOG = CATALOG;</script>
<Base title="Keranjang — Toko Kopi Bing" description="Isi keranjang belanjamu di Toko Kopi Bing." noindex={true}>
  <div class="wrap cartp">
    <a class="back tap" href="/#katalog">&#8592; Lanjut belanja</a>
    <div class="ttl"><h1>Keranjang</h1><span class="cnt" id="cnt"></span></div>

    <div id="empty" class="empty" style="display:none">
      <svg class="eico" width="96" height="96" viewBox="0 0 96 96" fill="none" aria-hidden="true">
        <circle cx="48" cy="48" r="44" fill="#E3EFF4"/>
        <path d="M24 32h9l6 28h26l6-20H36" stroke="#133F52" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="42" cy="68" r="4" fill="#133F52"/><circle cx="62" cy="68" r="4" fill="#133F52"/>
        <path d="M44 44c0-4 4-6 6-3 2-3 6-1 6 3 0 5-6 8-6 8s-6-3-6-8z" fill="#FADC56" stroke="#133F52" stroke-width="2.5" stroke-linejoin="round"/>
      </svg>
      <h2>Keranjang kamu masih kosong</h2>
      <p>Pilih kopinya dulu, nanti digiling saat kamu pesan.</p>
      <a class="btn btn-kuning" href="/#katalog">Lihat katalog kopi</a>
    </div>

    <div id="cartGrid" class="grid" style="display:none">
      <div id="list" class="list"></div>
      <aside id="summary" class="summary" data-muncul>
        <div class="row"><span id="subLabel">Subtotal</span><span id="subtotal">Rp 0</span></div>
        <div class="row"><span>Ongkir</span><span class="soft">Dihitung saat checkout</span></div>
        <div class="row total"><span>Total</span><span id="total">Rp 0</span></div>
        <p class="note">COD bisa &middot; bayar QRIS atau transfer BCA di langkah berikutnya</p>
        <!-- Hanya tampil di mode corong: jalan balik ke halaman pilihan supaya pembeli
             bisa menambah kopi lain tanpa keluar dari corong. -->
        <a class="addmore" id="addMore" href="/" style="display:none">+ Tambah kopi lain</a>
      </aside>
    </div>

    <!-- Di luar kotak: satu-satunya pintu ke katalog lengkap saat mode corong,
         karena tautan navigasi di header disembunyikan. -->
    <a class="allcat" id="allCat" href="/#katalog" style="display:none">Lihat semua katalog Kopi Bing</a>
  </div>

  <div class="bar" id="bar" style="display:none">
    <div class="bar-in">
      <div class="bar-tot"><span class="bl">Total</span><span class="bv" id="barTotal">Rp 0</span></div>
      <a class="btn btn-kuning" id="coBtn" href="/checkout">Lanjut ke checkout &rarr;</a>
    </div>
  </div>

  <style is:global>
    .cartp{ max-width:1080px; margin:0 auto; padding:14px 16px 120px; }
    .cartp .back{ display:inline-block; font-size:13px; font-weight:700; color:var(--biru); padding:4px 0; }
    .cartp .ttl{ display:flex; align-items:flex-end; gap:8px; margin:6px 0 14px; }
    .cartp h1{ font-size:24px; font-weight:800; color:var(--tinta); line-height:1.2; margin:0; }
    .cartp .cnt{ font-size:13px; font-weight:600; color:var(--redup); padding-bottom:3px; }

    .cartp .grid{ display:flex; flex-direction:column; gap:14px; }
    .cartp .list{ display:flex; flex-direction:column; gap:14px; }

    .cartp .empty{ text-align:center; padding:36px 16px 20px; max-width:380px; margin:0 auto; }
    .cartp .eico{ margin:0 auto 14px; display:block; }
    .cartp .empty h2{ font-size:18px; font-weight:800; color:var(--tinta); margin:0 0 6px; }
    .cartp .empty p{ font-size:14px; color:var(--redup); margin:0 0 20px; line-height:1.5; }
    .cartp .empty .btn{ display:inline-flex; }

    .cartp .item{ display:flex; gap:12px; background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); padding:12px; overflow:hidden; max-height:220px; }
    .cartp .item.out{ opacity:0; transform:scale(.96); transition:opacity .25s var(--ease), transform .25s var(--ease); }
    .cartp .ithumb{ width:76px; height:76px; border-radius:10px; object-fit:cover; flex-shrink:0; background:var(--kabut); }
    .cartp .meta{ flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
    .cartp .iname{ font-size:15px; font-weight:700; color:var(--tinta); line-height:1.3; }
    .cartp .ivar{ font-size:12px; font-weight:500; color:var(--redup); }
    .cartp .irow{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding-top:6px; }
    .cartp .qty{ display:flex; align-items:center; border:1px solid var(--garisk); border-radius:10px; overflow:hidden; background:#fff; }
    .cartp .qty button{ width:32px; height:32px; background:var(--latar); border:none; color:var(--birutua); font-size:16px; font-weight:700; line-height:1; cursor:pointer; font-family:inherit; }
    .cartp .qty span{ min-width:34px; height:32px; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; color:var(--tinta); }
    .cartp .iprice{ color:var(--biru); font-size:16px; font-weight:800; white-space:nowrap; }
    .cartp .rm{ align-self:flex-start; background:none; border:none; padding:2px 0; font:inherit; font-size:12px; font-weight:600; color:var(--redup); cursor:pointer; }
    .cartp .rm:hover{ color:var(--merah); }

    .cartp .summary{ background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); padding:16px; }
    .cartp .row{ display:flex; justify-content:space-between; gap:12px; font-size:13px; font-weight:500; color:var(--isi); margin-bottom:8px; }
    .cartp .row span:last-child{ font-weight:700; color:var(--tinta); }
    .cartp .row .soft{ font-weight:500; color:var(--redup); }
    .cartp .row.total{ align-items:center; font-size:15px; font-weight:800; color:var(--tinta); padding-top:10px; margin:2px 0 8px; border-top:1px solid var(--garis); }
    .cartp .row.total span:last-child{ font-size:18px; font-weight:800; }
    .cartp .note{ font-size:12px; font-weight:500; color:var(--redup); line-height:1.45; margin:0; }
    .cartp .addmore{ display:block; text-align:center; color:var(--biru); font-size:13px; font-weight:700; margin-top:14px; }
    .cartp .allcat{ display:block; text-align:center; color:var(--redup); font-size:13px; text-decoration:underline; margin-top:18px; }

    .bar{ position:fixed; left:0; right:0; bottom:0; z-index:40; background:#fff; border-top:1px solid var(--garis); padding:12px 16px calc(14px + env(safe-area-inset-bottom)); }
    .bar-in{ max-width:1080px; margin:0 auto; display:flex; align-items:center; gap:12px; }
    .bar-tot{ flex:1; display:flex; flex-direction:column; }
    .bar .bl{ font-size:11px; font-weight:600; color:var(--redup); }
    .bar .bv{ font-size:19px; font-weight:800; color:var(--tinta); }

    @media (min-width:860px){
      .cartp{ padding-top:24px; }
      .cartp h1{ font-size:30px; }
      .cartp .grid{ flex-direction:row; align-items:flex-start; gap:24px; }
      .cartp .list{ flex:1; min-width:0; }
      .cartp .summary{ width:340px; flex-shrink:0; position:sticky; top:90px; }
      .bar-in .btn{ min-width:260px; }
    }
  </style>

  <script>
    import { pruneCart } from '../data/scalev.js';

    // Mode corong: pengunjung datang dari halaman iklan (mis. /pahit) lewat ikon
    // keranjang yang membawa ?lp=. Saringan sama seperti halaman lain.
    const LP=(function(v){ v=String(v||''); return /^[a-z0-9-]{1,64}$/i.test(v) ? v : ''; })(new URLSearchParams(location.search).get('lp'));
    if(LP){
      const back=document.querySelector('.cartp .back');
      if(back){ back.setAttribute('href','/'+LP); back.textContent='← Kembali ke pilihan'; }
      const co=document.getElementById('coBtn');
      if(co) co.setAttribute('href','/checkout?lp='+encodeURIComponent(LP));
      const add=document.getElementById('addMore');
      if(add){ add.setAttribute('href','/'+LP); add.style.display='block'; }
      const all=document.getElementById('allCat');
      if(all) all.style.display='block';
    }

    const fmt=(n)=>"Rp "+n.toLocaleString('id-ID');
    const gulir=(id,t)=>{ const el=document.getElementById(id); if(!el) return; if(window.kbGulir) window.kbGulir(el,t); else el.textContent=t; };
    function load(){
      const raw=JSON.parse(localStorage.getItem('kb_cart')||'[]');
      const ok=pruneCart(raw, window.KB_CATALOG);
      // Produk ditarik dari katalog, atau namanya berubah - dua-duanya perlu disimpan balik.
      if(JSON.stringify(ok)!==JSON.stringify(raw)) save(ok);
      return ok;
    }
    function save(c){ localStorage.setItem('kb_cart',JSON.stringify(c)); const el=document.getElementById('cartCount'); if(el) el.textContent=c.reduce((s,i)=>s+i.qty,0); }

    function totals(cart, animate){
      const n=cart.reduce((s,i)=>s+i.qty,0);
      const sub=cart.reduce((s,i)=>s+i.price*i.qty,0);
      document.getElementById('cnt').textContent=n+' item';
      const put=animate ? gulir : (id,t)=>{ document.getElementById(id).textContent=t; };
      document.getElementById('subLabel').textContent='Subtotal ('+n+' item)';
      put('subtotal',fmt(sub)); put('total',fmt(sub)); put('barTotal',fmt(sub));
    }
    function showState(cart){
      const has=cart.length>0;
      document.getElementById('empty').style.display=has?'none':'block';
      document.getElementById('cartGrid').style.display=has?'':'none';
      document.getElementById('bar').style.display=has?'':'none';
      document.getElementById('cnt').style.display=has?'':'none';
    }
    function rowHtml(it){
      const w = it.g>=1000 ? '1kg' : it.g+'gr';
      return '<img class="ithumb" src="/img/'+it.slug+'.webp" alt="'+it.name+'" />'
        + '<div class="meta">'
          + '<div class="iname">'+it.name+'</div>'
          + '<div class="ivar">'+w+' &middot; '+it.grind+'</div>'
          + '<div class="irow">'
            + '<div class="qty"><button data-a="dec" aria-label="Kurangi">&minus;</button><span class="q">'+it.qty+'</span><button data-a="inc" aria-label="Tambah">+</button></div>'
            + '<div class="iprice">'+fmt(it.price*it.qty)+'</div>'
          + '</div>'
          + '<button class="rm" data-a="rm">Hapus</button>'
        + '</div>';
    }
    function render(){
      const cart=load();
      const list=document.getElementById('list');
      showState(cart);
      list.innerHTML='';
      if(!cart.length) return;
      cart.forEach(function(it,idx){
        const d=document.createElement('div');
        d.className='item'; d.dataset.i=idx; d.setAttribute('data-muncul','');
        d.style.setProperty('--tunda',Math.min(idx,6)*60+'ms');
        d.innerHTML=rowHtml(it);
        list.appendChild(d);
        // Pengamat di Base sudah jalan sebelum baris ini ada, jadi dinyalakan sendiri.
        requestAnimationFrame(()=>requestAnimationFrame(()=>d.classList.add('tampil')));
      });
      totals(cart,false);
    }
    function reindex(){ document.querySelectorAll('#list .item').forEach((d,i)=>{ d.dataset.i=i; }); }
    // Baris memudar dulu (~250 ms), baru dibuang dari DOM dan dari keranjang.
    function removeRow(row,i){
      if(row.classList.contains('out')) return;
      const done=()=>{
        const cart=load(); cart.splice(i,1); save(cart);
        row.remove(); reindex();
        if(!cart.length) render(); else totals(cart,true);
      };
      row.classList.add('out');
      if(matchMedia('(prefers-reduced-motion: reduce)').matches) done(); else setTimeout(done,250);
    }
    document.getElementById('list').addEventListener('click',(e)=>{
      const b=e.target.closest('[data-a]'); if(!b) return;
      const row=b.closest('.item'); if(!row || row.classList.contains('out')) return;
      const i=+row.dataset.i;
      const cart=load(); if(!cart[i]) return;
      if(b.dataset.a==='rm'){ removeRow(row,i); return; }
      if(b.dataset.a==='dec' && cart[i].qty<=1){ removeRow(row,i); return; }
      cart[i].qty += b.dataset.a==='inc' ? 1 : -1;
      save(cart);
      const it=cart[i];
      const q=row.querySelector('.q'), p=row.querySelector('.iprice');
      if(window.kbGulir){ window.kbGulir(q,String(it.qty)); window.kbGulir(p,fmt(it.price*it.qty)); }
      else { q.textContent=it.qty; p.textContent=fmt(it.price*it.qty); }
      totals(cart,true);
    });
    render();
  </script>
</Base>
