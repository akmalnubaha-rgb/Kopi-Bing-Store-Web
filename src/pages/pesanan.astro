---
import Base from '../layouts/Base.astro';
---
<Base title="Pesanan — Toko Kopi Bing" description="Detail dan status pesananmu di Toko Kopi Bing." noindex={true}>
  <div class="wrap op">
    <div id="loading" class="lo">Memuat pesanan...</div>
    <div id="err" class="lo err" style="display:none"></div>

    <div id="content" style="display:none">
      <div class="okhead">
        <div class="okic" id="okic">&#10003;</div>
        <h1 id="okttl">Pesanan diterima!</h1>
        <div class="oid" id="oid"></div>
        <span class="ostat" id="ostat"></span>
      </div>

      <div class="card">
        <div class="ct">Yang kamu pesan</div>
        <div id="items"></div>
        <div class="line"></div>
        <div class="row"><span>Subtotal produk</span><span id="subp"></span></div>
        <div class="row"><span>Ongkir</span><span id="ship"></span></div>
        <div class="row" id="ukrow"><span>Kode unik</span><span id="uk"></span></div>
        <div class="row total"><span id="totalLabel">Total transfer</span><span id="total"></span></div>
      </div>

      <div class="card pay" id="paycard">
        <div class="ct">Cara bayar &mdash; Transfer Bank</div>
        <div class="bankbox">
          <div class="brow"><span>Bank</span><b id="bankName">BCA</b></div>
          <div class="brow"><span>No. Rekening</span><b><span id="accNo">6520645142</span> <button class="copy" id="copyAcc">salin</button></b></div>
          <div class="brow"><span>Atas nama</span><b id="accHolder">Akmal Nubaha Rijal</b></div>
          <div class="brow big"><span>Jumlah</span><b id="amt"></b> <button class="copy" id="copyAmt">salin</button></div>
        </div>
        <p class="warn">Transfer <b>PERSIS</b> sampai angka terakhir (ada kode uniknya) biar pembayaran otomatis terverifikasi.</p>
        <input type="file" id="proofFile" accept="image/jpeg,image/png,image/webp" hidden />
        <button class="btn-buy full" id="btnUpload">&#128206; Sudah transfer &mdash; kirim bukti</button>
        <p class="note" id="uploadNote">Foto atau screenshot bukti transfernya ya. Format JPG, PNG, atau WEBP, maksimal 5 MB.</p>
        <button class="btn-outline full" id="btnPaid" style="margin-top:4px">Sudah transfer, buktinya nanti</button>
      </div>

      <div class="card pay" id="cancelcard" style="display:none">
        <div class="ct">Pesanan dibatalkan</div>
        <p class="warn" style="margin-bottom:0">Pesanan ini sudah dibatalkan, jadi <b>jangan ditransfer</b> ya. Kalau kamu terlanjur transfer atau mau pesan lagi, chat kami di WhatsApp <b>0851-6194-1214</b>.</p>
      </div>

      <div class="card pay" id="codcard" style="display:none">
        <div class="ct">Cara bayar &mdash; Bayar di Tempat (COD)</div>
        <div class="bankbox">
          <div class="brow big"><span>Siapkan uang</span><b id="codAmt"></b></div>
        </div>
        <p class="hint">Kamu <b>tidak perlu transfer</b>. Bayar langsung ke kurir waktu paketnya sampai. Siapkan uang pas ya biar gampang.</p>
      </div>

      <div class="card pay" id="epaycard" style="display:none">
        <div class="ct" id="epayTitle">Cara bayar</div>
        <div id="epayBody"><p class="note">Menyiapkan pembayaran...</p></div>
      </div>

      <div class="card done" id="donecard" style="display:none">
        <div class="okic sm" id="doneic">&#8987;</div>
        <div class="ct2" id="donebody"></div>
        <a class="btn-outline full" id="btnBukti" target="_blank" rel="noopener" style="margin-top:14px">&#128206; Kirim bukti pembayaran</a>
      </div>

      <a class="backhome" href="/">&#8592; Kembali ke toko</a>
    </div>
  </div>

  <style is:global>
    .op{ max-width:560px; margin:0 auto; padding:24px 16px 20px; }
    .op .lo{ text-align:center; color:var(--muted); padding:50px 0; }
    .op .lo.err{ color:#A3502F; line-height:1.6; }
    .op .okhead{ text-align:center; margin-bottom:22px; }
    .op .okic{ width:60px; height:60px; border-radius:50%; background:var(--green); color:#fff; font-size:32px; display:flex; align-items:center; justify-content:center; margin:0 auto 12px; }
    .op .okic.pending{ background:var(--yellow); color:#6B3B15; }
    .op .okic.sm{ width:44px; height:44px; font-size:22px; background:var(--yellow); color:#6B3B15; margin-bottom:10px; }
    .op h1{ font-size:23px; font-weight:600; }
    .op .oid{ color:var(--muted); font-size:13px; margin-top:6px; }
    .op .ostat{ display:inline-block; margin-top:10px; background:#FBE9C8; color:#8A5A12; font-size:12px; font-weight:500; padding:5px 13px; border-radius:20px; }
    .op .ostat.ok{ background:#E7F0DE; color:#3B6D11; }
    .op .card{ background:#fff; border:0.5px solid #E6D6B8; border-radius:14px; padding:18px; margin-bottom:14px; }
    .op .ct{ color:#6B4E37; font-size:13px; font-weight:600; margin-bottom:14px; }
    .op .ct2{ color:var(--ink); font-size:14px; text-align:center; line-height:1.65; }
    .op .ct2 b{ font-size:15px; }
    .op .it{ display:flex; justify-content:space-between; gap:12px; font-size:14px; color:var(--ink); margin-bottom:8px; }
    .op .line{ height:0.5px; background:#E6D6B8; margin:10px 0 12px; }
    .op .row{ display:flex; justify-content:space-between; font-size:14px; color:#6B4E37; margin-bottom:9px; }
    .op .row.total{ font-size:18px; color:var(--ink); font-weight:600; padding-top:12px; margin-bottom:0; border-top:0.5px solid #E6D6B8; }
    .op .bankbox{ background:#FBF2DF; border-radius:11px; padding:14px 16px; margin-bottom:12px; }
    .op .brow{ display:flex; justify-content:space-between; align-items:center; gap:10px; font-size:14px; color:#7A6551; padding:5px 0; }
    .op .brow b{ color:var(--ink); font-weight:500; }
    .op .brow.big{ border-top:0.5px solid #E7D6B4; margin-top:6px; padding-top:12px; }
    .op .brow.big b{ font-size:20px; font-weight:600; color:var(--brown); }
    .op .copy{ background:#fff; border:0.5px solid #D8C6A8; color:var(--teal-d); font-size:11px; padding:3px 9px; border-radius:6px; cursor:pointer; font-family:inherit; margin-left:6px; }
    .op .warn{ background:#FDECEA; color:#A3502F; font-size:12.5px; line-height:1.5; padding:10px 13px; border-radius:9px; margin-bottom:14px; }
    .op .hint{ background:#EAF6F8; color:#0B5C6B; font-size:12.5px; line-height:1.6; padding:11px 13px; border-radius:9px; }
    .op .brow b.vanum{ font-size:19px; font-weight:600; color:var(--brown); letter-spacing:0.5px; }
    .op .qrstr{ background:#FBF2DF; border-radius:9px; padding:11px 13px; font-size:11px; color:#6B4E37; word-break:break-all; line-height:1.5; margin-bottom:12px; }
    .op .qrbox{ background:#fff; border:0.5px solid #E6D6B8; border-radius:11px; padding:14px; margin:0 auto 12px; max-width:280px; }
    .op .qrbox svg{ display:block; width:100%; height:auto; }
    .op .btn-buy.full{ display:block; width:100%; text-align:center; }
    .op .btn-buy.full:disabled{ opacity:.6; cursor:not-allowed; }
    .op .btn-outline{ display:block; width:100%; text-align:center; background:#fff; color:var(--brown); border:1.5px solid #D8C6A8; border-radius:9px; padding:12px; font-weight:500; font-size:14px; font-family:inherit; cursor:pointer; }
    .op .btn-outline:hover{ background:#FBF2DF; }
    .op .note{ color:var(--muted); font-size:12px; text-align:center; margin-top:12px; }
    .op .note.err{ color:#A3502F; }
    .op .proof{ display:block; max-width:220px; border-radius:9px; border:0.5px solid #E6D6B8; margin:12px auto 0; }
    .op .done{ text-align:center; }
    .op .backhome{ display:block; text-align:center; color:var(--brown); font-size:13px; margin-top:16px; }
  </style>

  <script>
    import { getOrder, patchOrder, createPayment, transferProofUpload, putFile,
             trackMeta, analyticsItems, readOrderMeta, clearOrderMeta, sweepOrderMeta,
             purchaseFired, markPurchaseFired } from '../data/scalev.js';
    import qrcode from 'qrcode-generator';
    const fmt=(n)=>"Rp "+Number(n).toLocaleString('id-ID');
    const $=(id)=>document.getElementById(id);
    const SCALEV_ORDER_HOST='https://kopi-bing.myscalev.com/o/';
    function slugFromPath(){
      const parts=location.pathname.split('/').filter(Boolean);
      if(parts[0]==='o' && parts[1]) return parts[1];
      return new URLSearchParams(location.search).get('id') || '';
    }
    // Status Scalev yang berarti "sudah dibayar / sudah jalan". 'confirmed' = Moota sudah cocokkan mutasi.
    const PAID=['paid','confirmed','in_process','ready','shipped','delivered','completed'];
    const CANCELED=['canceled','cancelled','expired','closed'];
    const WA_CS='0851-6194-1214';
    const MAX_PROOF=5*1024*1024;
    const PROOF_TYPES=['image/jpeg','image/png','image/webp'];
    let slug='', payMethod='bank_transfer', pollTimer=null, order=null, bankAcc=null;

    const PAY_NAME={ bank_transfer:'Transfer Bank', cod:'Bayar di Tempat (COD)', qris:'QRIS', invoice:'Virtual Account / E-Wallet',
      va_bca:'Virtual Account BCA', va_bni:'Virtual Account BNI', va_bri:'Virtual Account BRI', va_bsi:'Virtual Account BSI',
      va_mandiri:'Virtual Account Mandiri', dana:'DANA', ovo:'OVO', shopeepay:'ShopeePay' };

    // Ambil data bayar dari pg_payment_info (bentuknya beda-beda per provider).
    function payInfo(o){
      const pg=o.pg_payment_info||{};
      const pm=pg.payment_method||{};
      const va=(pm.virtual_account&&pm.virtual_account.channel_properties)||{};
      const otc=(pm.over_the_counter&&pm.over_the_counter.channel_properties)||{};
      const qr=(pm.qr_code&&pm.qr_code.channel_properties)||{};
      let link=pg.payment_url||pg.invoice_url||pg.redirect_url||'';
      if(!link && Array.isArray(pg.actions)){
        const pick=function(t){ const a=pg.actions.find(function(x){ return String(x.url_type||'').toUpperCase()===t; }); return a&&(a.url||a.value||''); };
        link=pick('WEB')||pick('DEEPLINK')||pick('MOBILE')||'';
      }
      // pg.va_number / va_name / bank_code = bentuk Singapay. Sisanya bentuk Xendit di dokumentasi Scalev.
      return { vaNumber:pg.va_number||va.virtual_account_number||otc.payment_code||'',
        vaHolder:pg.va_name||va.customer_name||otc.customer_name||'',
        bankName:pg.bank_code||'',
        qrString:pg.qr_string||qr.qr_string||'', link:link, expiredAt:pg.expired_at||o.payment_expiration_at||'' };
    }
    function fmtExp(s){
      if(!s) return '';
      // Singapay kirim epoch milidetik, Scalev kirim string ISO.
      const d=(typeof s==='number'||/^\d+$/.test(String(s))) ? new Date(Number(s)) : new Date(s);
      if(isNaN(d.getTime())) return '';
      try{ return d.toLocaleString('id-ID',{ day:'numeric', month:'long', hour:'2-digit', minute:'2-digit', timeZone:'Asia/Jakarta' })+' WIB'; }catch(e){ return ''; }
    }

    // Tampilan bayar untuk metode otomatis (VA, e-wallet, QRIS, invoice).
    async function showEpay(o){
      $('paycard').style.display='none';
      $('epaycard').style.display='block';
      $('epayTitle').textContent='Cara bayar — '+(PAY_NAME[payMethod]||'Pembayaran otomatis');
      let info=payInfo(o);
      if(!info.vaNumber && !info.link && !info.qrString){
        // Instruksi bayar belum dibuat. Endpoint ini idempoten, aman dipanggil ulang.
        try{ const p=await createPayment(slug); info=payInfo(Object.assign({}, o, p||{})); }catch(e){}
      }
      const amt=fmt(o.gross_revenue||0);
      const exp=fmtExp(info.expiredAt);
      let html='';
      if(info.vaNumber){
        html+='<div class="bankbox">'
          +(info.bankName?'<div class="brow"><span>Bank</span><b>'+info.bankName+'</b></div>':'')
          +'<div class="brow"><span>Nomor VA</span><b><span class="vanum" id="vaNo">'+info.vaNumber+'</span> <button class="copy" data-c="'+info.vaNumber+'">salin</button></b></div>'
          +(info.vaHolder?'<div class="brow"><span>Atas nama</span><b>'+info.vaHolder+'</b></div>':'')
          +'<div class="brow big"><span>Jumlah</span><b>'+amt+'</b> <button class="copy" data-c="'+Math.round(Number(o.gross_revenue||0))+'">salin</button></div>'
          +'</div>'
          +'<p class="hint">Buka m-banking kamu, pilih menu Virtual Account, lalu masukkan nomor di atas. Pembayaran terverifikasi otomatis.</p>';
      } else if(info.link){
        html+='<div class="bankbox"><div class="brow big"><span>Jumlah</span><b>'+amt+'</b></div></div>'
          +'<a class="btn-buy full" href="'+info.link+'" target="_blank" rel="noopener">Bayar sekarang</a>'
          +'<p class="hint" style="margin-top:12px">Tombol di atas membuka halaman pembayaran. Di sana kamu pilih bank/e-wallet-nya. Setelah bayar, balik ke halaman ini &mdash; statusnya update sendiri.</p>';
      } else if(info.qrString){
        html+='<div class="qrbox" id="qrbox"></div>'
          +'<div class="bankbox"><div class="brow big"><span>Jumlah</span><b>'+amt+'</b></div></div>'
          +'<p class="hint">Scan QR di atas pakai GoPay, OVO, DANA, ShopeePay, atau m-banking apa pun yang ada QRIS-nya. Kalau kamu bayar dari HP yang sama, screenshot dulu QR-nya lalu pilih menu unggah dari galeri di aplikasinya.</p>';
      } else {
        html+='<div class="bankbox"><div class="brow big"><span>Jumlah</span><b>'+amt+'</b></div></div>'
          +'<a class="btn-buy full" href="'+SCALEV_ORDER_HOST+slug+'" target="_blank" rel="noopener">Buka halaman pembayaran</a>'
          +'<p class="hint" style="margin-top:12px">Instruksi bayarnya kami buka di halaman terpisah ya.</p>';
      }
      if(exp) html+='<p class="note">Bayar sebelum '+exp+'.</p>';
      $('epayBody').innerHTML=html;
      // QR digambar di browser: Scalev cuma mengirim string QRIS, bukan gambarnya.
      if(info.qrString && $('qrbox')){
        try{
          const qr=qrcode(0,'M'); qr.addData(info.qrString); qr.make();
          $('qrbox').innerHTML=qr.createSvgTag({ cellSize:6, margin:2, scalable:true });
        }catch(e){
          $('qrbox').outerHTML='<p class="hint" style="margin-bottom:12px">Salin kode QRIS di bawah, lalu buka aplikasi e-wallet kamu.</p>'
            +'<div class="qrstr">'+info.qrString+'</div>'
            +'<button class="btn-outline full copy" data-c="'+info.qrString+'">Salin kode QRIS</button>';
        }
      }
      startPolling();
    }

    // Metode otomatis: status berubah di sisi Scalev, jadi halaman ini yang mengecek berkala.
    function startPolling(){
      if(pollTimer) return;
      let n=0;
      pollTimer=setInterval(async function(){
        n++; if(n>60){ clearInterval(pollTimer); pollTimer=null; return; }
        try{
          const res=await getOrder(slug); const o=res.data||res; order=o;
          const st=String(o.status||'').toLowerCase();
          const paid=PAID.indexOf(st)>=0 || String(o.payment_status||'').toLowerCase()==='paid';
          if(paid){ clearInterval(pollTimer); pollTimer=null; showPaid(); window.scrollTo({top:0,behavior:'smooth'}); }
          else if(CANCELED.indexOf(st)>=0){ showCanceled(); window.scrollTo({top:0,behavior:'smooth'}); }
        }catch(e){}
      }, 15000);
    }

    function showProcessing(){
      $('paycard').style.display='none';
      $('okttl').textContent='Terima kasih!';
      $('okic').classList.add('pending'); $('okic').innerHTML='&#8987;';
      const st=$('ostat'); st.textContent='Menunggu konfirmasi pembayaran'; st.classList.remove('ok');
      $('doneic').innerHTML='&#8987;';
      const adaBukti=!!(order&&order.transferproof_url);
      // Halaman ini yang mengecek sendiri ke Scalev (startPolling), jadi janji "berubah sendiri" memang ditepati.
      // Jangan janjikan notifikasi WhatsApp: toko ini belum punya integrasi WA, dan email pelanggan tidak terkirim.
      $('donebody').innerHTML='<b>Terima kasih! Pembayaranmu sedang kami cek.</b><br>'
        +(adaBukti?'Bukti transfermu sudah kami terima. ':'')
        +'Status di halaman ini <b>berubah sendiri</b> begitu pembayaranmu masuk, jadi halaman ini boleh dibiarkan terbuka. '
        +'Kalau lewat 1 jam masih belum berubah, chat kami di WhatsApp <b>'+WA_CS+'</b> ya.'
        +(adaBukti?'<img class="proof" src="'+order.transferproof_url+'" alt="Bukti transfer yang kamu kirim" />':'');
      $('btnBukti').style.display=adaBukti?'none':'block';
      $('donecard').style.display='block';
      startPolling();
    }
    function showCanceled(){
      if(pollTimer){ clearInterval(pollTimer); pollTimer=null; }
      $('paycard').style.display='none'; $('epaycard').style.display='none';
      $('codcard').style.display='none'; $('donecard').style.display='none';
      $('okttl').textContent='Pesanan dibatalkan';
      $('okic').classList.add('pending'); $('okic').innerHTML='&#10005;';
      const st=$('ostat'); st.textContent='Dibatalkan'; st.classList.remove('ok');
      $('cancelcard').style.display='block';
    }
    // Purchase ditembakkan di sini, saat pembayaran benar-benar masuk - bukan saat order dibuat.
    // Sekali per order per browser; Meta juga men-dedup lewat event_id yang sama di jalur browser & CAPI.
    function firePurchase(){
      if(!order) return;
      const oid=String(order.order_id||'');
      if(!oid || purchaseFired(oid)) return;
      const m=readOrderMeta(oid); // dititipkan dari checkout
      const lines=order.orderlines||[];
      // Unique id varian ada di peta `order.variants`, jadi tidak bergantung pada titipan checkout.
      const ai=analyticsItems(order);
      const params={
        content_ids: ai.content_ids.length ? ai.content_ids
                    : ((m&&m.ids) || lines.map(function(l){ return String(l.product_name||''); })),
        content_type:'product',
        value: Number(order.gross_revenue || (m&&m.value) || 0),
        currency:'IDR',
        num_items: ai.num_items || (m&&m.num) || lines.reduce(function(s,l){ return s+(Number(l.quantity)||0); },0),
      };
      // Kota/provinsi tetap ada di payload publik; HP disensor, jadi hanya dari titipan checkout.
      const dest=order.destination_address||{};
      const userData={ ph:(m&&m.ph)||undefined, ct:(m&&m.ct)||dest.city||undefined, st:(m&&m.st)||dest.province||undefined,
                       external_id: order.customer_id ? String(order.customer_id) : ((m&&m.ex)||undefined) };
      try{
        trackMeta('Purchase', params, oid+'-Purchase', userData, ai.items);
        markPurchaseFired(oid);
        clearOrderMeta(oid); // titipan berisi nomor HP, tidak dibutuhkan lagi setelah ini
      }catch(e){}
    }

    function showPaid(){
      firePurchase();
      $('paycard').style.display='none'; $('epaycard').style.display='none'; $('codcard').style.display='none';
      $('okttl').textContent='Terima kasih!';
      const cod=payMethod==='cod';
      const st=$('ostat'); st.textContent=cod?'Pesanan dikonfirmasi':'Pembayaran diterima'; st.classList.add('ok');
      $('doneic').innerHTML='&#10003;'; $('doneic').classList.remove('sm'); $('doneic').classList.add('sm');
      $('donebody').innerHTML=cod
        ? '<b>Pesananmu sudah kami konfirmasi!</b><br>Segera kami siapkan dan kirim. Siapkan uang pas untuk dibayarkan ke kurir waktu paketnya sampai.'
        : '<b>Pembayaran kamu sudah kami terima!</b><br>Pesananmu segera kami siapkan dan kirim. Terima kasih sudah belanja di Kopi Bing.';
      $('btnBukti').style.display='none';
      $('donecard').style.display='block';
    }

    (async function(){
      sweepOrderMeta();
      slug=slugFromPath();
      if(!slug){ $('loading').style.display='none'; $('err').style.display='block'; $('err').textContent='Nomor pesanan tidak ditemukan.'; return; }
      $('btnBukti').href=SCALEV_ORDER_HOST+slug;
      try{
        const res=await getOrder(slug); const o=res.data||res; order=o;
        $('oid').textContent='No. Pesanan: '+(o.order_id||'-');
        try{
          const accs=(o.store&&o.store.payment_accounts)||[];
          const bt=accs.find(function(a){return a.method==='bank_transfer';})||accs[0];
          if(bt){ bankAcc=bt; $('bankName').textContent=(bt.financial_entity&&bt.financial_entity.name)||'BCA'; $('accNo').textContent=bt.account_number; $('accHolder').textContent=bt.account_holder; }
        }catch(e){}
        const lines=o.orderlines||[];
        $('items').innerHTML=lines.map(function(l){ return '<div class="it"><span>'+l.product_name+' &times; '+l.quantity+'</span><span>'+fmt(Number(l.variant_price)*l.quantity)+'</span></div>'; }).join('') || '<div class="it"><span>Pesanan kamu</span></div>';
        $('subp').textContent=fmt(o.product_price||0);
        $('ship').textContent=fmt(o.shipping_cost||0);
        const uk=Number(o.unique_code_discount||0);
        if(uk>0){ $('uk').textContent='- '+fmt(uk); } else { $('ukrow').style.display='none'; }
        $('total').textContent=fmt(o.gross_revenue||0);
        $('amt').textContent=fmt(o.gross_revenue||0);
        $('copyAcc').dataset.c=String($('accNo').textContent).replace(/\D/g,'');
        $('copyAmt').dataset.c=String(Math.round(Number(o.gross_revenue||0)));

        payMethod=String(o.payment_method||'bank_transfer').toLowerCase();
        const isCod = payMethod==='cod';
        const isTransfer = payMethod==='bank_transfer';
        $('totalLabel').textContent = isCod ? 'Total bayar ke kurir' : (isTransfer ? 'Total transfer' : 'Total bayar');
        $('codAmt').textContent=fmt(o.gross_revenue||0);

        const ostatus = String(o.status||'').toLowerCase();
        const isPaid = PAID.indexOf(ostatus)>=0 || String(o.payment_status||'').toLowerCase()==='paid';
        if(isPaid){ showPaid(); }
        else if(CANCELED.indexOf(ostatus)>=0){ showCanceled(); }
        else if(isCod){
          $('paycard').style.display='none'; $('codcard').style.display='block';
          $('ostat').textContent='Bayar saat barang sampai';
        }
        else if(!isTransfer){
          $('ostat').textContent='Menunggu pembayaran';
          showEpay(o);
        }
        else if(o.transfer_time){ showProcessing(); }
        else { $('ostat').textContent='Menunggu pembayaran'; }

        $('loading').style.display='none'; $('content').style.display='block';
      }catch(e){
        $('loading').style.display='none'; $('err').style.display='block';
        $('err').innerHTML='Pesanan tidak ditemukan atau linknya sudah kedaluwarsa.<br><br>Kalau kamu baru saja pesan, hubungi kami di WhatsApp <b>0851-6194-1214</b>.';
      }
    })();

    function setUploadNote(msg, isErr){ const n=$('uploadNote'); if(!n) return; n.textContent=msg; n.classList.toggle('err', !!isErr); }

    // Upload bukti: minta URL -> kirim file -> tempelkan ke order berikut rekening tujuannya.
    async function uploadProof(file){
      const btn=$('btnUpload'), label=btn.textContent;
      if(PROOF_TYPES.indexOf(file.type)<0){ setUploadNote('Formatnya harus JPG, PNG, atau WEBP ya.', true); return; }
      if(file.size>MAX_PROOF){ setUploadNote('Ukuran filenya maksimal 5 MB. Coba screenshot ulang atau perkecil dulu.', true); return; }
      btn.disabled=true; btn.textContent='Mengirim bukti...';
      setUploadNote('Sebentar ya, buktinya lagi dikirim.', false);
      try{
        const up=await transferProofUpload(slug, { filename:file.name, content_type:file.type, content_length:file.size });
        if(!up || !up.upload_url || !up.file_url) throw new Error('Data upload tidak lengkap.');
        await putFile(up.upload_url, file);
        const body={ transferproof_url: up.file_url, transfer_time: new Date().toISOString() };
        // Rekening tujuan ikut dikirim biar order tahu uangnya masuk ke mana.
        if(bankAcc){
          if(bankAcc.financial_entity && bankAcc.financial_entity.id) body.financial_entity_id=bankAcc.financial_entity.id;
          if(bankAcc.account_holder) body.payment_account_holder=bankAcc.account_holder;
          if(bankAcc.account_number) body.payment_account_number=bankAcc.account_number;
        }
        await patchOrder(slug, body);
        if(order) order.transferproof_url=up.file_url;
        showProcessing();
        window.scrollTo({top:0,behavior:'smooth'});
      }catch(err){
        btn.disabled=false; btn.textContent=label;
        setUploadNote('Bukti belum terkirim. Coba lagi ya, atau kirim lewat WhatsApp '+WA_CS+'.', true);
      }
    }

    document.addEventListener('change', function(e){
      if(e.target && e.target.id==='proofFile'){
        const f=e.target.files && e.target.files[0];
        e.target.value='';
        if(f) uploadProof(f);
      }
    });

    document.addEventListener('click', async function(e){
      const cp=e.target.closest('.copy');
      if(cp){ try{ navigator.clipboard.writeText(cp.dataset.c); const t=cp.textContent; cp.textContent='tersalin'; setTimeout(function(){cp.textContent=t;},1200); }catch(err){} return; }
      if(e.target.closest('#btnUpload')){ $('proofFile').click(); return; }
      const paid=e.target.closest('#btnPaid');
      if(paid){
        const label=paid.textContent;
        paid.disabled=true; paid.textContent='Menyimpan...';
        try{
          await patchOrder(slug, { transfer_time: new Date().toISOString() });
          showProcessing();
          window.scrollTo({top:0,behavior:'smooth'});
        }catch(err){
          // Jangan tampilkan "sedang diproses" kalau nyatanya tidak tersimpan.
          paid.disabled=false; paid.textContent=label;
          setUploadNote('Belum tersimpan. Coba lagi ya, atau chat kami di WhatsApp '+WA_CS+'.', true);
        }
      }
    });
  </script>
</Base>
