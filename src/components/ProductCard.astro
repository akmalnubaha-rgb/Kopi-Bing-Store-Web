---
const { p } = Astro.props;
const min = p.prices[100];
const fmt = (n)=> "Rp " + n.toLocaleString('id-ID');
const noteClass = p.taste === 'pahit' ? 'n-brown' : (p.taste==='asem' ? 'n-teal' : 'n-mix');
---
<a class="card" href={`/produk/${p.slug}`}>
  <div class="thumb">
    <img src={`/img/${p.slug}.webp`} alt={p.name} loading="lazy" />
  </div>
  <div class="body">
    <div class="nm">{p.name}</div>
    <div class="notes">
      <span class={"tag " + noteClass}>{p.notes[0]}</span>
      {p.notes[1] && <span class="tag n-soft">{p.notes[1]}</span>}
    </div>
    <div class="price">mulai {fmt(min)}</div>
  </div>
</a>
<style>
  .card{ display:block; background:#fff; border:0.5px solid #D3E2E8; border-radius:12px; overflow:hidden; transition:transform .12s, box-shadow .12s; }
  .card:hover{ transform:translateY(-2px); box-shadow:0 6px 18px rgba(36,126,158,.12); }
  .thumb{ aspect-ratio:1/1; background:#E6F0F3; }
  .thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .body{ padding:11px 13px; }
  .nm{ font-size:14px; font-weight:500; color:var(--ink); }
  .notes{ margin:6px 0; display:flex; gap:5px; flex-wrap:wrap; }
  .tag{ font-size:10px; padding:3px 9px; border-radius:20px; }
  .n-brown{ background:#E1ECF0; color:#247E9E; }
  .n-teal{ background:#DCEFF3; color:#0A6B7E; }
  .n-mix{ background:#E6EFF2; color:#36586A; }
  .n-soft{ background:#E6EFF2; color:#17566F; }
  .price{ font-size:14px; font-weight:500; color:var(--brand); }
</style>
