---
const { p } = Astro.props;
const rb = (n)=> "Rp " + n.toLocaleString('id-ID');
const tagTeks = p.taste === 'pahit' ? 'PAHIT' : (p.taste==='asem' ? 'ASAM' : 'SEIMBANG');
import fs from 'node:fs';
import path from 'node:path';
const real = fs.existsSync(path.join(process.cwd(), 'public', 'img', 'real', `${p.slug}.webp`));
const foto = real ? `/img/real/${p.slug}.webp` : `/img/${p.slug}.webp`;
---
<a class="card" href={`/produk/${p.slug}`}>
  <div class="thumb">
    <img src={foto} alt={p.name} loading="lazy" data-vt={p.slug} />
  </div>
  <div class="body">
    <div class="tags">
      <span class={"tag t-" + p.taste}>{tagTeks}</span>
      {p.bestseller && <span class="tag t-laris">TERLARIS</span>}
    </div>
    <div class="nm">{p.name}</div>
    <div class="price">{rb(p.prices[100])} <small>/100 gr</small></div>
    {p.prices[1000] && <div class="kg">1 kg {rb(p.prices[1000])}</div>}
  </div>
</a>
<style>
  .card{ display:block; height:100%; background:#fff; border:1px solid var(--garis); border-radius:var(--r-kartu); overflow:hidden; transition:transform var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease), border-color var(--dur-2); }
  /* Angkat + zoom foto hanya di perangkat dengan mouse: di HP, :hover menempel sesudah diketuk. */
  @media(hover:hover) and (pointer:fine){
    .card:hover{ transform:translateY(-3px); box-shadow:0 10px 22px rgba(19,63,82,.12); border-color:var(--garisk); }
    .card:hover .thumb img{ transform:scale(1.05); }
  }
  .card:active{ transform:scale(.97); box-shadow:none; transition-duration:.08s; }
  .thumb{ aspect-ratio:1/1; background:var(--kabut); margin:7px 7px 0; border-radius:10px; overflow:hidden; }
  .thumb img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform var(--dur-3) var(--ease); }
  .body{ padding:10px 10px 12px; }
  .tags{ display:flex; gap:5px; flex-wrap:wrap; margin-bottom:7px; }
  .tag{ font-size:10px; font-weight:700; letter-spacing:.04em; padding:3px 8px; border-radius:6px; line-height:1.3; }
  .t-pahit{ background:var(--birutua); color:#fff; }
  .t-asem{ background:var(--biru); color:#fff; }
  .t-seimbang{ background:var(--kabut); color:var(--birutua); }
  .t-laris{ background:var(--kuning); color:var(--birutua); }
  .nm{ font-size:14px; font-weight:600; color:var(--tinta); line-height:1.3; }
  .price{ font-size:16px; font-weight:700; color:var(--biru); margin-top:3px; }
  .price{ white-space:nowrap; }
  .price small{ font-size:11px; font-weight:600; color:var(--redup); }
  .kg{ font-size:11px; color:var(--redup); margin-top:2px; }
</style>
